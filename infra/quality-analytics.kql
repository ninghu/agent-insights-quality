.create-merge table DailyQualityPublications (
    ReportDate:datetime,
    RunId:string,
    PublishedAt:datetime,
    SourceDigest:string,
    Payload:dynamic,
    PayloadVersion:string
)

.alter-merge table DailyQualityPublications policy retention softdelete = 730d recoverability = enabled

.alter table DailyQualityPublications policy caching hot = 90d

.create-or-alter function with (
    folder = 'Agent Insights Quality',
    docstring = 'Latest published daily qualification result for each Pacific report date.'
) AIQDailyPublications() {
    DailyQualityPublications
    | where PayloadVersion == '3.0.0'
    | summarize arg_max(PublishedAt, *) by ReportDate
    | project ReportDate, RunId, PublishedAt, SourceDigest, PayloadVersion, Payload
}

.create-or-alter function with (
    folder = 'Agent Insights Quality',
    docstring = 'Daily qualification summary metrics.'
) AIQDailyRuns() {
    AIQDailyPublications()
    | project
        ReportDate,
        RunId,
        PublishedAt,
        ReportUrl = tostring(Payload.run.report_url),
        QualityScore = todouble(Payload.run.quality_score),
        QualityScoreFormula = tostring(Payload.run.quality_score_formula),
        BaselinePassed = toint(Payload.run.baseline_passed),
        IssuesCorrect = toint(Payload.run.issues_correct),
        IssuesIncorrect = toint(Payload.run.issues_incorrect),
        IssuesMissing = toint(Payload.run.issues_missing),
        IssuesExpected = toint(Payload.run.issues_expected),
        NoiseCards = toint(Payload.run.noise_cards),
        DuplicateCards = toint(Payload.run.duplicate_cards)
}

.create-or-alter function with (
    folder = 'Agent Insights Quality',
    docstring = 'Per-Agent daily qualification metrics.'
) AIQDailyAgents() {
    AIQDailyPublications()
    | mv-expand AgentMetric = Payload.agents to typeof(dynamic)
    | project
        ReportDate,
        RunId,
        PublishedAt,
        Agent = tostring(AgentMetric.agent),
        Owner = tostring(AgentMetric.owner),
        AgentType = tostring(AgentMetric.agent_type),
        Framework = tostring(AgentMetric.framework),
        AgentReportUrl = tostring(AgentMetric.agent_report_url),
        SelectedIssueIds = AgentMetric.selected_issue_ids,
        BaselineStatus = tostring(AgentMetric.baseline_status),
        BaselineVerdict = tostring(AgentMetric.baseline_verdict),
        BaselineOwnership = tostring(AgentMetric.baseline_ownership),
        BaselineOwnershipReason = tostring(AgentMetric.baseline_ownership_reason),
        BaselineInsightCount = toint(AgentMetric.baseline_insight_count),
        BaselineRuntimeEvidenceComplete =
            tobool(AgentMetric.baseline_runtime_evidence_complete),
        IssuesExpected = toint(AgentMetric.issues_expected),
        IssuesCorrect = toint(AgentMetric.issues_correct),
        IssuesIncorrect = toint(AgentMetric.issues_incorrect),
        IssuesMissing = toint(AgentMetric.issues_missing),
        NoiseCards = toint(AgentMetric.noise_cards),
        DuplicateCards = toint(AgentMetric.duplicate_cards),
        FieldsPassed = toint(AgentMetric.fields_passed),
        FieldsExpected = toint(AgentMetric.fields_expected)
}

.create-or-alter function with (
    folder = 'Agent Insights Quality',
    docstring = 'Per-issue daily qualification outcomes.'
) AIQDailyIssues() {
    AIQDailyPublications()
    | mv-expand IssueMetric = Payload.issues to typeof(dynamic)
    | project
        ReportDate,
        RunId,
        PublishedAt,
        Agent = tostring(IssueMetric.agent),
        Owner = tostring(IssueMetric.owner),
        AgentType = tostring(IssueMetric.agent_type),
        Framework = tostring(IssueMetric.framework),
        IssueId = tostring(IssueMetric.issue_id),
        IssueTitle = tostring(IssueMetric['title']),
        Category = tostring(IssueMetric.category),
        Severity = tostring(IssueMetric.severity),
        ExpectedRootCause = tostring(IssueMetric.expected_root_cause),
        ExpectedFix = tostring(IssueMetric.expected_fix),
        Status = tostring(IssueMetric.status),
        ErrorCode = tostring(IssueMetric.error_code),
        Outcome = tostring(IssueMetric.outcome),
        Detail = tostring(IssueMetric.detail),
        Verdict = tostring(IssueMetric.verdict),
        Ownership = tostring(IssueMetric.ownership),
        OwnershipReason = tostring(IssueMetric.ownership_reason),
        FindingType = tostring(IssueMetric.finding_type),
        ObservedCount = toint(IssueMetric.observed_count),
        RuntimeEvidenceComplete = tobool(IssueMetric.runtime_evidence_complete),
        Confidence = todouble(IssueMetric.confidence),
        CardCount = toint(IssueMetric.card_count),
        PassingFields = IssueMetric.passing_fields,
        FailingFields = IssueMetric.failing_fields,
        FieldsPassed = toint(IssueMetric.fields_passed),
        FieldsExpected = toint(IssueMetric.fields_expected),
        IssueUrl = tostring(IssueMetric.issue_url),
        AgentReportUrl = tostring(IssueMetric.agent_report_url),
        ReportUrl = tostring(IssueMetric.report_url)
}

.create-or-alter function with (
    folder = 'Agent Insights Quality',
    docstring = 'Per-field daily qualification outcomes.'
) AIQDailyFields() {
    AIQDailyPublications()
    | mv-expand FieldMetric = Payload.fields to typeof(dynamic)
