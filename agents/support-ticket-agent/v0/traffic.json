{
  "contract_version": "1.0",
  "agent_name": "support-ticket-agent",
  "logical_version": "v0",
  "coverage": [
    "grounded_success",
    "normal_latency_and_token_use",
    "bounded_latency_and_output",
    "ordinary_model_work",
    "handled_transient_tool_failure",
    "handled_agent_error_or_partial_result"
  ],
  "requests": [
    {
      "id": "support-ticket-agent-v0-grounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Read ticket-demo-1."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-support-ticket-agent-v0-1"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns the grounded synthetic ticket."
      }
    },
    {
      "id": "support-ticket-agent-v0-bounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Summarize ticket-demo-2 in one sentence."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-support-ticket-agent-v0-2"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns a bounded response."
      }
    },
    {
      "id": "support-ticket-agent-v0-ordinary",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Confirm update for ticket-demo-1 at revision 3."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-support-ticket-agent-v0-3"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Validates revision before updating."
      }
    },
    {
      "id": "support-ticket-agent-v0-transient",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Recover ticket-demo-1 after one temporary read failure."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-support-ticket-agent-v0-4"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Retries once and recovers.",
        "semantic_assertions": {
          "required_terms_all": [
            "succeeded",
            "retry"
          ],
          "forbidden_claims": [
            "retry failed",
            "did not succeed",
            "recovery failed"
          ]
        }
      }
    },
    {
      "id": "support-ticket-agent-v0-partial",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Read ticket-demo-1 while its optional history is unavailable."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-support-ticket-agent-v0-5"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns the core ticket and labels history unavailable.",
        "semantic_assertions": {
          "exact_text": "Ticket ID ticket-demo-1; revision 3; status open; summary Synthetic printer setup; optional history unavailable."
        }
      }
    }
  ],
  "data_class": "synthetic_public_safe",
  "traffic_source": "endpoint_requests"
}
