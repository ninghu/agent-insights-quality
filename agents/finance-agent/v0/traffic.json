    {
      "id": "finance-agent-v0-transient",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Retry one temporary balance failure for acct-demo-a."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-finance-agent-v0-4"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Retries once and recovers.",
        "semantic_assertions": {
          "required_terms_any": ["1250.50", "1,250.50", "1250", "USD", "balance"]
        },
        "trace_assertions": [
          {
            "name": "exact_transient_retry_count",
            "kind": "tool_call_count",
            "tool_name": "get_balance_with_transient",
            "count": 2
          },
          {
            "name": "exact_transient_retry_sequence",
            "kind": "retry_sequence",
            "tool_name": "get_balance_with_transient",
            "result_sequence": ["error", "success"]
          },
          {
            "name": "exact_transient_retry_scope",
            "kind": "scope_relation",
            "tool_name": "get_balance_with_transient",
            "scope_kind": "account",
            "request_scope": "first",
            "argument": "account_id",
            "request_tool_equal": true
          }
        ]
      }
    },
