      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Show the balance for acct-demo-a."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-finance-agent-v0-1"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns the authoritative synthetic balance."
      }
    },
