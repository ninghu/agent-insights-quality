  "kind": "hosted",
  "protocol_versions": [
    {"protocol": "responses", "version": "1.0.0"}
  ],
  "cpu": "1",
  "memory": "2Gi",
  "container_configuration": {
    "image": "${AIQ_TICKET_IMAGE_URI}"
  },
  "environment_variables": {
    "AZURE_AI_MODEL_DEPLOYMENT_NAME": "${AIQ_MODEL_DEPLOYMENT_NAME}",
    "AZURE_AI_PROJECT_ENDPOINT": "${AIQ_PROJECT_ENDPOINT}"
  }
}
