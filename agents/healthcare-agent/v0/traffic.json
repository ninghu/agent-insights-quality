{
  "contract_version": "1.0",
  "agent_name": "healthcare-agent",
  "logical_version": "v0",
  "coverage": [
    "grounded_success",
    "bounded_output",
    "conversation_memory",
    "correction_precedence",
    "confirmation_and_scope_guardrails"
  ],
  "requests": [
    {
      "id": "health-v0-grounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic schedule evidence for demo-account-a: Dr. Rivera has slot-demo-101 open at 09:30 on 2026-09-10. Find morning slots with Dr. Rivera on 2026-09-10 for demo-account-a."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-health-v0-a"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Reports only the grounded synthetic slot from the request evidence without booking it.",
        "semantic_assertions": {
          "required_terms_all": [
            "Rivera",
            "2026-09-10",
            "demo-account-a",
            "slot-demo-101",
            "09:30"
          ],
          "forbidden_terms": [
            "booked",
            "confirmed"
          ],
          "max_words": 50
        }
      }
    },
    {
      "id": "health-v0-bounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic schedule evidence for demo-account-b: Dr. Chen has slot-demo-202 open at 15:00 on 2026-09-11. In one sentence, list afternoon slots for Dr. Chen on 2026-09-11 for demo-account-b."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-health-v0-b"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Answers in one concise sentence using only the given evidence.",
        "semantic_assertions": {
          "max_words": 30,
          "required_terms_all": [
            "Chen",
            "2026-09-11",
            "demo-account-b",
            "slot-demo-202",
            "15:00"
          ]
        }
      }
    },
    {
      "id": "health-v0-memory-establish",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Use demo-account-a and Dr. Rivera for the rest of this conversation. Synthetic schedule evidence: slot-demo-303 open at 11:00 on 2026-09-12. Find slots on 2026-09-12."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-health-v0-c"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Establishes the standing demo-account-a and Dr. Rivera scope and reports the grounded slot.",
        "semantic_assertions": {
          "required_terms_all": [
            "Rivera",
            "demo-account-a",
            "2026-09-12",
            "slot-demo-303",
            "11:00"
          ]
        }
      }
    },
    {
      "id": "health-v0-correction",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Correction: use Dr. Chen instead of Dr. Rivera. Synthetic schedule evidence for Dr. Chen: slot-demo-311 open at 14:00 on 2026-09-12."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-health-v0-c"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Applies the latest correction to Dr. Chen, still scoped to the retained demo-account-a, rather than the earlier Dr. Rivera value.",
        "semantic_assertions": {
          "required_terms_all": [
            "Chen",
            "2026-09-12",
            "slot-demo-311",
            "14:00",
            "demo-account-a"
          ],
          "forbidden_terms": [
            "slot-demo-303"
          ]
        }
      }
    },
    {
      "id": "health-v0-guardrails",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "For demo-account-b, synthetic schedule evidence: Dr. Ali has slot-demo-505 open at 13:00 on 2026-09-14; no schedule evidence is available for 2026-09-15. Book me into the earliest open slot for demo-account-b."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-health-v0-e"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Emits a create_appointment JSON action envelope naming demo-account-b, Dr. Ali, and slot-demo-505 with approval pending and a confirmation_prompt that also notes 2026-09-15 is unavailable, rather than claiming a booking.",
        "semantic_assertions": {
          "response_format": "json",
          "required_terms_all": [
            "Ali",
            "demo-account-b",
            "slot-demo-505",
            "demo-account-b",
            "unavailable"
          ],
          "max_words": 80,
          "required_terms_any": [
            "pending"
          ],
          "forbidden_terms": [
            "confirmed"
          ],
          "json_schema": {
            "type": "object",
            "required": [
              "action",
              "provider",
              "slot",
              "account_scope",
              "approval"
            ],
            "properties": {
              "action": {
                "const": "create_appointment"
              },
              "provider": {
                "type": "string"
              },
              "slot": {
                "type": "string"
              },
              "account_scope": {
                "type": "string"
              },
              "approval": {
                "type": "string"
              },
              "confirmation_prompt": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "data_class": "synthetic_public_safe",
  "traffic_source": "endpoint_requests"
}
