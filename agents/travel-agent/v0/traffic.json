{
  "contract_version": "1.0",
  "agent_name": "travel-agent",
  "logical_version": "v0",
  "coverage": [
    "grounded_success",
    "normal_latency_and_token_use",
    "bounded_latency_and_output",
    "ordinary_model_work",
    "handled_transient_tool_failure",
    "handled_agent_error_or_partial_result"
  ],
  "requests": [
    {
      "id": "travel-agent-v0-grounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Find a flight for trip-alpha."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-travel-agent-v0-1"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns only authoritative synthetic inventory."
      }
    },
    {
      "id": "travel-agent-v0-bounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Find one hotel for trip-beta."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-travel-agent-v0-2"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns a compact result with bounded work."
      }
    },
    {
      "id": "travel-agent-v0-ordinary",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Compare flight and hotel for trip-gamma."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-travel-agent-v0-3"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Runs independent searches concurrently.",
        "semantic_assertions": {
          "required_terms_all": [
            "flight-demo-0",
            "hotel-demo-0",
            "price",
            "USD 200",
            "USD 120",
            "Booking not completed",
            "Showing 2 of 4"
          ],
          "forbidden_terms": [
            "Booking completed",
            "flight-demo-1",
            "hotel-demo-1"
          ]
        }
      }
    },
    {
      "id": "travel-agent-v0-transient",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Retry one temporary flight search for trip-alpha."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-travel-agent-v0-4"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Retries once and recovers."
      }
    },
    {
      "id": "travel-agent-v0-partial",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Compare flight and hotel for trip-beta when hotel search is unavailable."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-travel-agent-v0-5"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Labels the available flight result partial."
      }
    }
  ],
  "data_class": "synthetic_public_safe",
  "traffic_source": "endpoint_requests"
}
