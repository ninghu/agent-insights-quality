    {
      "id": "weather-v0-grounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Use Fahrenheit for the rest of this conversation. Synthetic current-conditions evidence for Austin: condition=sunny, temperature=86, unit=fahrenheit. What is the current weather?"
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-a"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Establishes the Fahrenheit preference and returns only the deterministic grounded current-conditions sentence.",
        "semantic_assertions": {
          "exact_text": "Austin: sunny, 86 Fahrenheit."
        }
      }
    },
    {
      "id": "weather-v0-memory-followup",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic current-conditions evidence for Denver: condition=snow, temperature=25. What is the weather now?"
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-a"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Applies the retained Fahrenheit preference and returns only the deterministic grounded current-conditions sentence.",
        "semantic_assertions": {
          "exact_text": "Denver: snow, 25 Fahrenheit."
        }
      }
    },
    {
      "id": "weather-v0-bounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
