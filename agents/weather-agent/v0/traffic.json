            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic current-conditions evidence for Public Demo Location 3: condition=clear, temperature=21, unit=celsius. Return exactly this bare JSON object with no prose or Markdown fences: {\"condition\":\"clear\",\"temperature\":21,\"unit\":\"celsius\"}"
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-c"
          },
          "max_output_tokens": 400
        }
