{
  "contract_version": "1.0",
  "agent_name": "weather-agent",
  "logical_version": "v0",
  "coverage": [
    "grounded_success",
    "bounded_output",
    "response_format_contract",
    "conversation_memory",
    "incomplete_evidence_handling"
  ],
  "requests": [
    {
      "id": "weather-v0-grounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Use Fahrenheit for the rest of this conversation. Synthetic current-conditions evidence for Austin: condition=sunny, temperature=86, unit=fahrenheit. What is the current weather?"
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-a"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Establishes the Fahrenheit preference and returns only the deterministic grounded current-conditions sentence.",
        "semantic_assertions": {
          "exact_text": "Austin: sunny, 86 Fahrenheit."
        }
      }
    },
    {
      "id": "weather-v0-memory-followup",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic current-conditions evidence for Denver: condition=snow, temperature=25. What is the weather now?"
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-a"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Applies the retained Fahrenheit preference and returns only the deterministic grounded current-conditions sentence.",
        "semantic_assertions": {
          "exact_text": "Denver: snow, 25 Fahrenheit."
        }
      }
    },
    {
      "id": "weather-v0-bounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic forecast evidence for Oslo tomorrow: condition=cloudy, high=12, low=7, unit=celsius. Give the one-day forecast in at most 20 words."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-b"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns only the deterministic one-day forecast sentence using the request evidence.",
        "semantic_assertions": {
          "exact_text": "Oslo tomorrow: cloudy, high 12 Celsius, low 7 Celsius."
        }
      }
    },
    {
      "id": "weather-v0-json",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic current-conditions evidence for Public Demo Location 3: condition=clear, temperature=21, unit=celsius. Return JSON with exactly the keys condition, temperature, and unit."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-c"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns valid JSON with exactly the requested keys and grounded values.",
        "semantic_assertions": {
          "response_format": "json",
          "exact_json": {
            "condition": "clear",
            "temperature": 21,
            "unit": "celsius"
          }
        }
      }
    },
    {
      "id": "weather-v0-partial",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic forecast evidence for Reykjavik: day one condition=windy, high=9, low=5, unit=celsius; day two evidence is unavailable. Give the two-day forecast."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-d"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns only the deterministic partial forecast sentence and marks day two unavailable.",
        "semantic_assertions": {
          "exact_text": "Reykjavik day one: windy, high 9 Celsius, low 5 Celsius. Day two: unavailable."
        }
      }
    }
  ],
  "data_class": "synthetic_public_safe",
  "traffic_source": "endpoint_requests"
}
