{
  "contract_version": "1.0",
  "agent_name": "weather-agent",
  "logical_version": "v0",
  "coverage": [
    "grounded_success",
    "bounded_output",
    "response_format_contract",
    "conversation_memory",
    "incomplete_evidence_handling"
  ],
  "requests": [
    {
      "id": "weather-v0-grounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Use Fahrenheit for the rest of this conversation. Synthetic current-conditions evidence for Austin: condition=sunny, temperature=86, unit=fahrenheit. What is the current weather?"
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-a"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Establishes the Fahrenheit preference and reports the grounded 86 F sunny result from the request evidence.",
        "semantic_assertions": {
          "required_terms_all": [
            "Austin",
            "86",
            "sunny",
            "fahrenheit"
          ],
          "forbidden_terms": [
            "unavailable",
            "not sunny",
            "not 86"
          ],
          "max_words": 40
        }
      }
    },
    {
      "id": "weather-v0-memory-followup",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic current-conditions evidence for Denver: condition=snow, temperature=25. What is the weather now?"
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-a"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Applies the retained Fahrenheit preference from the earlier turn and reports 25 degrees Fahrenheit with snow, without asking again.",
        "semantic_assertions": {
          "required_terms_all": [
            "Denver",
            "25",
            "snow",
            "fahrenheit"
          ],
          "max_words": 40,
          "forbidden_terms": [
            "celsius",
            "not snow",
            "not 25"
          ]
        }
      }
    },
    {
      "id": "weather-v0-bounded",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic forecast evidence for Oslo tomorrow: condition=cloudy, high=12, low=7, unit=celsius. Give the one-day forecast in at most 20 words."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-b"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Answers the one-day forecast in at most 20 words using only the given evidence.",
        "semantic_assertions": {
          "max_words": 20,
          "required_terms_all": [
            "cloudy",
            "12",
            "7",
            "celsius"
          ],
          "forbidden_terms": [
            "not cloudy",
            "not 12",
            "not 7",
            "fahrenheit"
          ]
        }
      }
    },
    {
      "id": "weather-v0-json",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic current-conditions evidence for Public Demo Location 3: condition=clear, temperature=21, unit=celsius. Return JSON with exactly the keys condition, temperature, and unit."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-c"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Returns valid JSON with exactly the requested keys and grounded values.",
        "semantic_assertions": {
          "response_format": "json",
          "required_terms_all": [
            "clear",
            "21",
            "celsius"
          ],
          "json_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "temperature",
              "unit"
            ],
            "properties": {
              "condition": {
                "const": "clear"
              },
              "temperature": {
                "const": 21
              },
              "unit": {
                "const": "celsius"
              }
            }
          }
        }
      }
    },
    {
      "id": "weather-v0-partial",
      "request": {
        "method": "POST",
        "path": "/responses",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "input": [
            {
              "role": "user",
              "content": [
                {
                  "type": "input_text",
                  "text": "Synthetic forecast evidence for Reykjavik: day one condition=windy, high=9, low=5, unit=celsius; day two evidence is unavailable. Give the two-day forecast."
                }
              ]
            }
          ],
          "conversation": {
            "id": "conv-weather-v0-d"
          },
          "max_output_tokens": 400
        }
      },
      "expected": {
        "http_status": 200,
        "behavior": "Reports day one from the evidence and explicitly labels day two as unavailable instead of guessing.",
        "semantic_assertions": {
          "required_terms_all": [
            "windy",
            "9",
            "5",
            "unavailable"
          ],
          "max_words": 60,
          "forbidden_claims": [
            "day two is available",
            "day two: sunny"
          ]
        }
      }
    }
  ],
  "data_class": "synthetic_public_safe",
  "traffic_source": "endpoint_requests"
}
