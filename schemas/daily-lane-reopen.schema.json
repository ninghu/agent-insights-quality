{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "execution_id",
    "run_contract_digest",
    "agent_name",
    "assigned_issue_ids",
    "original_checkout_commit_sha",
    "recovery_commit_sha",
    "catalog_hashes",
    "registry_digest",
    "original_receipt_digest",
    "accepted_baseline_digest",
    "recovery_verifier_digest",
    "event_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "daily-lane-reopen"},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_contract_digest": {"$ref": "#/$defs/hash"},
    "agent_name": {"$ref": "#/$defs/agent"},
    "assigned_issue_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^issue-[0-9]{3}$"}
    },
    "original_checkout_commit_sha": {"$ref": "#/$defs/gitSha"},
    "recovery_commit_sha": {"$ref": "#/$defs/gitSha"},
    "catalog_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "issues", "artifacts"],
      "properties": {
        "agents": {"$ref": "#/$defs/hash"},
        "issues": {"$ref": "#/$defs/hash"},
        "artifacts": {"$ref": "#/$defs/hash"}
      }
    },
    "registry_digest": {"$ref": "#/$defs/hash"},
    "original_receipt_digest": {"$ref": "#/$defs/hash"},
    "accepted_baseline_digest": {"$ref": "#/$defs/hash"},
    "recovery_verifier_digest": {"$ref": "#/$defs/hash"},
    "event_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "agent": {
      "enum": [
        "weather-agent",
        "healthcare-agent",
        "finance-agent",
        "travel-agent",
        "support-ticket-agent"
      ]
    }
  }
}
