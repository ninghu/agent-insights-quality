{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "executive_summary", "patterns", "isolated_observations", "improvement_priorities", "exclusions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model": {"const": "gpt-5.6-sol"},
    "executive_summary": {"type": "string", "minLength": 1, "maxLength": 800},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_key", "title", "why_it_is_a_pattern", "supporting_agents", "evidence", "improvement", "measurable_signal", "confidence"],
        "properties": {
          "pattern_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "why_it_is_a_pattern": {"type": "string", "minLength": 1, "maxLength": 800},
          "supporting_agents": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["finding_id", "agent", "detail"],
              "properties": {
                "finding_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9./-]{2,159}$"
                },
                "agent": {"type": "string", "minLength": 1},
                "issue_id": {"type": ["string", "null"], "pattern": "^issue-[0-9]{3}$"},
                "detail": {"type": "string", "minLength": 1, "maxLength": 400}
              }
            }
          },
          "improvement": {"type": "string", "minLength": 1, "maxLength": 800},
          "measurable_signal": {"type": "string", "minLength": 1, "maxLength": 400},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "isolated_observations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    },
    "improvement_priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_key", "why_it_matters"],
        "properties": {
          "pattern_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    }
  }
}
