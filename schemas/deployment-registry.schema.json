{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "environment_id", "location", "telemetry_resource_set", "account_name", "project_name", "test_region", "test_agent_model", "catalog_hashes", "agents"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "profile": {"enum": ["daily", "staging"]},
    "environment_id": {"const": "swedencentral-g30"},
    "location": {"const": "swedencentral"},
    "telemetry_resource_set": {"const": "g30"},
    "account_name": {"enum": ["aiq-daily-swedencentral", "aiq-staging-swedencentral"]},
    "project_name": {"enum": ["aiq-daily-swedencentral", "aiq-staging-swedencentral"]},
    "test_region": {"const": "SwedenCentral"},
    "test_agent_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_name", "model_id", "model_version"],
      "properties": {
        "deployment_name": {"const": "gpt-5.4-mini"},
        "model_id": {"const": "gpt-5.4-mini"},
        "model_version": {"const": "2026-03-17"}
      }
    },
    "catalog_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "issues", "artifacts"],
      "properties": {
        "agents": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "issues": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifacts": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["monitor_id", "versions"],
        "properties": {
          "monitor_id": {"type": "string", "minLength": 1},
          "versions": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["foundry_version", "content_digest"],
              "properties": {
                "foundry_version": {"type": "string", "minLength": 1},
                "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
