{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninghu/agent-insights-quality/schemas/test-agent-validation-copilot-evaluation.schema.json",
  "title": "Test Agent Validation Copilot authority evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "model",
    "package_hash",
    "authority_id",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "test-agent-validation-copilot-evaluation"},
    "model": {"const": "gpt-5.6-sol"},
    "package_hash": {"$ref": "#/$defs/hash"},
    "authority_id": {"$ref": "#/$defs/authorityId"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorityId": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
        {"type": "string", "pattern": "^issue-[0-9]{3}$"}
      ]
    },
    "errorCode": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "evidence_insufficient",
            "ambiguous_evidence",
            "missing_evidence",
            "contradictory_evidence"
          ]
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion",
        "passed",
        "evidence_sufficient"
      ],
      "properties": {
        "assertion": {"type": "string", "minLength": 1, "maxLength": 128},
        "passed": {"type": "boolean"},
        "evidence_sufficient": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "evidence_sufficient",
        "semantic_assertions",
        "trace_assertions"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$"
        },
        "evidence_sufficient": {"type": "boolean"},
        "semantic_assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "trace_assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "evidence_sufficient",
        "observation",
        "error_code",
        "steps"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 10},
        "evidence_sufficient": {"type": "boolean"},
        "observation": {"type": "boolean"},
        "error_code": {"$ref": "#/$defs/errorCode"},
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "issue_attempts", "v0_attempts"],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "issue_attempts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/attempt"}
        },
        "v0_attempts": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/attempt"}
        }
      }
    }
  }
}
