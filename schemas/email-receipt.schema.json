{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_digest", "status", "provider_reference", "retry_allowed"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["sent", "failed", "unknown"]},
    "provider_reference": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "retry_allowed": {"type": "boolean"}
  }
}
