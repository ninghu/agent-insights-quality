{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_kind",
    "agent_name",
    "foundry_version",
    "manifest_reference",
    "source_integrity",
    "validation_mode",
    "n",
    "k",
    "execution_digest",
    "runtime_status",
    "operation_count",
    "endpoint_evidence",
    "full_request_trace_proof",
    "observed_insights",
    "expected",
    "package_hash"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "target_kind": {"enum": ["baseline", "issue"]},
    "agent_name": {"enum": ["weather-agent", "healthcare-agent", "finance-agent", "travel-agent", "support-ticket-agent"]},
    "foundry_version": {"type": "string", "minLength": 1},
    "manifest_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "contract_digest"],
      "properties": {
        "verified": {"const": true},
        "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "validation_mode": {
      "enum": ["baseline", "deterministic", "model_mediated"]
    },
    "n": {"enum": [5, 7]},
    "k": {"const": 5},
    "execution_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "required_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["semantic", "trace"]}
    },
    "issue_trace_gap_acceptance": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/issueTraceGapAcceptance"}
      ]
    },
    "runtime_status": {"enum": ["passed", "not_at_bar", "observed", "inconclusive", "skipped_baseline"]},
    "error_code": {"type": ["string", "null"]},
    "operation_count": {"type": "integer", "minimum": 0},
    "endpoint_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "response_count",
        "usable_response_count",
        "trace_contract_verified",
        "semantic_assertion_count",
        "semantic_assertions_passed",
        "trace_assertion_count",
        "trace_assertions_passed",
        "request_summaries"
      ],
      "properties": {
        "request_count": {"type": "integer", "minimum": 0},
        "response_count": {"type": "integer", "minimum": 0},
        "usable_response_count": {"type": "integer", "minimum": 0},
        "trace_contract_verified": {"type": "boolean"},
        "semantic_assertion_count": {"type": "integer", "minimum": 0},
        "semantic_assertions_passed": {"type": "integer", "minimum": 0},
        "trace_assertion_count": {"type": "integer", "minimum": 0},
        "trace_assertions_passed": {"type": "integer", "minimum": 0},
        "request_summaries": {
          "type": "array",
          "items": {"$ref": "#/$defs/requestSummary"}
        }
      }
    },
    "full_request_trace_proof": {
      "oneOf": [
        {"type": "object", "maxProperties": 0},
        {"$ref": "#/$defs/traceProof"}
      ]
    },
    "behavior_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_complete",
        "semantic_assertions_complete",
        "terminal_evidence_complete",
        "direct_prompt_contract_complete"
      ],
      "properties": {
        "endpoint_complete": {"type": "boolean"},
        "semantic_assertions_complete": {"type": "boolean"},
        "terminal_evidence_complete": {"type": "boolean"},
        "direct_prompt_contract_complete": {"type": ["boolean", "null"]}
      }
    },
    "observed_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "agent_version",
          "title",
          "description",
          "category",
          "severity",
          "proposed_fix",
          "trace_count",
          "linked_operation_ids",
          "card_linked_trace_proof"
        ],
        "properties": {
          "reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "agent_version": {"type": "string", "maxLength": 100},
          "title": {"type": "string", "maxLength": 300},
          "description": {"type": "string", "maxLength": 4000},
          "category": {"type": "string", "maxLength": 100},
          "severity": {"type": "string", "maxLength": 50},
          "proposed_fix": {"type": "string", "maxLength": 4000},
          "trace_count": {"type": "integer", "minimum": 0},
          "linked_operation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
          },
          "card_linked_trace_proof": {"$ref": "#/$defs/traceProof"}
        }
      }
    },
    "expected": {"type": "object"},
    "issue_id": {"type": "string", "pattern": "^issue-[0-9]{3}$"},
    "evidence_reference": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instructions": {"type": "string", "minLength": 1},
    "package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"target_kind": {"const": "baseline"}}},
      "then": {
        "required": ["behavior_summary"],
        "not": {
          "anyOf": [
            {"required": ["issue_id"]},
            {"required": ["evidence_reference"]},
            {"required": ["instructions"]},
            {"required": ["required_surfaces"]}
          ]
        },
        "properties": {
          "validation_mode": {"const": "baseline"},
          "n": {"const": 5},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["insight_count", "behavior"],
            "properties": {
              "insight_count": {"const": 0},
              "behavior": {"$ref": "#/$defs/baselineContract"}
            }
          }
        }
      },
      "else": {
        "required": ["issue_id", "evidence_reference", "instructions", "required_surfaces", "issue_trace_gap_acceptance"],
        "not": {"required": ["behavior_summary"]},
        "properties": {
          "validation_mode": {
            "enum": ["deterministic", "model_mediated"]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "root_cause",
              "category",
              "severity",
              "expected_fix",
              "minimum_traces"
            ],
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 300},
              "root_cause": {"type": "string", "minLength": 1, "maxLength": 4000},
              "category": {"type": "string", "minLength": 1, "maxLength": 100},
              "severity": {"enum": ["low", "medium", "high"]},
              "expected_fix": {"type": "string", "minLength": 1, "maxLength": 4000},
              "minimum_traces": {"type": "integer", "minimum": 1}
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "validation_mode": {"const": "model_mediated"}
              }
            },
            "then": {
              "properties": {
                "n": {"const": 7},
                "issue_trace_gap_acceptance": {"type": "null"}
              }
            },
            "else": {
              "properties": {
                "n": {"const": 5}
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "traceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_count",
        "tool_call_counts",
        "tool_response_count",
        "successful_tool_response_count",
        "error_codes",
        "assistant_response_count",
        "explicit_terminal_success_count",
        "explicit_terminal_output_count",
        "terminal_success_count",
        "terminal_output_count",
        "terminal_response_count",
        "handled_error_count",
        "unhandled_error_count"
      ],
      "properties": {
        "operation_count": {"type": "integer", "minimum": 0},
        "tool_call_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "tool_response_count": {"type": "integer", "minimum": 0},
        "successful_tool_response_count": {"type": "integer", "minimum": 0},
        "error_codes": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "assistant_response_count": {"type": "integer", "minimum": 0},
        "explicit_terminal_success_count": {"type": "integer", "minimum": 0},
        "explicit_terminal_output_count": {"type": "integer", "minimum": 0},
        "terminal_success_count": {"type": "integer", "minimum": 0},
        "terminal_output_count": {"type": "integer", "minimum": 0},
        "terminal_response_count": {"type": "integer", "minimum": 0},
        "handled_error_count": {"type": "integer", "minimum": 0},
        "unhandled_error_count": {"type": "integer", "minimum": 0}
      }
    },
    "baselineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_count",
        "terminal_response",
        "semantic_assertions",
        "function_calling",
        "trace_operations",
        "validation_mode"
      ],
      "properties": {
        "request_count": {"const": 5},
        "terminal_response": {
          "enum": [
            "direct_prompt",
            "standard_assistant_message",
            "explicit_span_attributes"
          ]
        },
        "semantic_assertions": {
          "enum": ["required", "required_per_request"]
        },
        "function_calling": {"enum": ["forbidden", "not_applicable"]},
        "trace_operations": {"enum": ["uniform", "required_per_request"]},
        "validation_mode": {"const": "baseline"}
      }
    },
    "requestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_index",
        "response_count",
        "usable_response",
        "semantic_assertion_count",
        "semantic_assertions_passed",
        "assertion_results",
        "trace_assertion_count",
        "trace_assertions_passed",
        "trace_assertion_results",
        "activation_gate",
        "direct_terminal_response_count",
        "function_call_count",
        "error_code"
      ],
      "properties": {
        "request_index": {"type": "integer", "minimum": 0},
        "response_count": {"type": "integer", "minimum": 0},
        "usable_response": {"type": "boolean"},
        "semantic_assertion_count": {"type": "integer", "minimum": 0},
        "semantic_assertions_passed": {"type": "integer", "minimum": 0},
        "assertion_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion", "passed", "evidence_sufficient"],
            "properties": {
              "assertion": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"},
              "evidence_sufficient": {"type": "boolean"}
            }
          }
        },
        "trace_assertion_count": {"type": "integer", "minimum": 0},
        "trace_assertions_passed": {"type": "integer", "minimum": 0},
        "trace_assertion_results": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion", "passed"],
            "properties": {
              "assertion": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"}
            }
          }
        },
        "activation_gate": {"type": "boolean"},
        "direct_terminal_response_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "function_call_count": {"type": "integer", "minimum": 0},
        "error_code": {
          "type": ["string", "null"],
          "enum": [null, "missing_evidence", "assertion_failed"]
        }
      }
    },
    "issueTraceGapAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "observation_count", "unknown_attempt_indices"],
      "properties": {
        "policy": {
          "const": "deterministic_issue_trace_gap_first_mature_batch_v1"
        },
        "observation_count": {"type": "integer", "minimum": 3, "maximum": 4},
        "unknown_attempt_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    }
  }
}
