{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninghu.github.io/agent-insights-quality/schemas/v1/daily-plan.schema.json",
  "title": "Agent Insights Quality daily plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_digest",
    "artifact_directory",
    "report_date",
    "created_at",
    "catalog_version",
    "catalog_hash",
    "policy_version",
    "policy_hash",
    "planner_version",
    "seed",
    "selection_mode",
    "human_daily_contract",
    "selection",
    "limits",
    "per_agent_expected_totals",
    "engine",
    "project",
    "coverage",
    "assignments"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "pattern": "^aiq-[0-9]{8}(?:-r[0-9]{2})?$"},
    "plan_digest": {"$ref": "#/$defs/sha256"},
    "artifact_directory": {
      "type": "string",
      "pattern": "^reports/daily/[0-9]{4}/[0-9]{2}/[0-9]{2}(?:/aiq-[0-9]{8}-r[0-9]{2})?$"
    },
    "report_date": {"type": "string", "format": "date"},
    "created_at": {"type": "string", "format": "date-time"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "catalog_hash": {"$ref": "#/$defs/sha256"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_hash": {"$ref": "#/$defs/sha256"},
    "planner_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "seed": {"type": "integer", "minimum": 0},
    "selection_mode": {"enum": ["rotating_daily", "full_catalog"]},
    "human_daily_contract": {"type": "boolean"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle",
        "mandatory_scenario_ids",
        "rotating_scenario_ids",
        "selected_scenario_ids",
        "omitted_scenario_ids",
        "selection_reasons"
      ],
      "properties": {
        "cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "number",
            "business_day",
            "weekday",
            "length_business_days",
            "full_coverage_horizon_business_days"
          ],
          "properties": {
            "id": {"type": "string", "pattern": "^cycle--?[0-9]+-[0-9a-f]{12}$"},
            "number": {"type": "integer"},
            "business_day": {
              "oneOf": [
                {"type": "integer", "minimum": 1, "maximum": 5},
                {"type": "null"}
              ]
            },
            "weekday": {
              "enum": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "non_scheduled"
              ]
            },
            "length_business_days": {"const": 5},
            "full_coverage_horizon_business_days": {"const": 5}
          }
        },
        "mandatory_scenario_ids": {"$ref": "#/$defs/scenario_ids"},
        "rotating_scenario_ids": {"$ref": "#/$defs/scenario_ids"},
        "selected_scenario_ids": {"$ref": "#/$defs/scenario_ids"},
        "omitted_scenario_ids": {"$ref": "#/$defs/scenario_ids"},
        "selection_reasons": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "healthy_control_daily",
              "p0_fault_daily",
              "p0_collection_probe_cadence",
              "rotating_priority_fairness",
              "full_catalog_release"
            ]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_insight_cap_per_agent",
        "expected_root_cap_per_run",
        "actual_insight_count_rule",
        "expected_cap_enforced"
      ],
      "properties": {
        "expected_insight_cap_per_agent": {"const": 4},
        "expected_root_cap_per_run": {"const": 4},
        "actual_insight_count_rule": {"const": "exact_expected"},
        "expected_cap_enforced": {"type": "boolean"}
      }
    },
    "per_agent_expected_totals": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "propertyNames": {"pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_reference", "build", "generator_model"],
      "properties": {
        "endpoint_reference": {"$ref": "#/$defs/sha256"},
        "build": {"type": "string", "minLength": 1, "maxLength": 200},
        "generator_model": {"const": "gpt-5.6-terra"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "resource_reference", "expires_on"],
      "properties": {
        "name": {"type": "string", "pattern": "^aiq-[0-9]{8}(?:-r[0-9]{2})?$"},
        "resource_reference": {"$ref": "#/$defs/sha256"},
        "expires_on": {"type": "string", "format": "date"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_count",
        "healthy_control_count",
        "families",
        "categories",
        "severities",
        "agent_types"
      ],
      "properties": {
        "scenario_count": {"type": "integer", "minimum": 1},
        "healthy_control_count": {"type": "integer", "minimum": 1},
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "severities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "agent_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["prompt", "hosted_code", "hosted_custom_container"]}
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "scenario_version",
          "family",
          "selection_reason",
          "conflict_tags",
          "run_id",
          "agent_id",
          "agent_name",
          "agent_type",
          "agent_version_digest",
          "version_sequence",
          "wave",
          "traffic_seed",
          "traffic_seed_namespace",
          "traffic_recipe_id",
          "traffic_requests",
          "lifecycle",
          "window",
          "expected"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^aiq-scn-[0-9]{3}-[a-z][a-z0-9-]*$"
          },
          "scenario_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "family": {"type": "string", "minLength": 1},
          "selection_reason": {
            "enum": [
              "healthy_control_daily",
              "p0_fault_daily",
              "p0_collection_probe_cadence",
              "rotating_priority_fairness",
              "full_catalog_release"
            ]
          },
          "conflict_tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
          },
          "run_id": {"type": "string", "pattern": "^run-[0-9]{2}-aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
          "agent_id": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
          "agent_name": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*.*$"},
          "agent_type": {"enum": ["prompt", "hosted_code", "hosted_custom_container"]},
          "agent_version_digest": {"$ref": "#/$defs/sha256"},
          "version_sequence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phase", "version_key", "digest", "window"],
              "properties": {
                "phase": {
                  "enum": [
                    "healthy",
                    "faulted",
                    "faulted-initial",
                    "faulted-repeat",
                    "corrected",
                    "recurred"
                  ]
                },
                "version_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "digest": {"$ref": "#/$defs/sha256"},
                "window": {"$ref": "#/$defs/window"}
              }
            }
          },
          "wave": {"type": "integer", "minimum": 0},
          "traffic_seed": {"type": "integer", "minimum": 0},
          "traffic_seed_namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*-v[0-9]+$"
          },
          "traffic_recipe_id": {"type": "string", "pattern": "^traffic-[a-z0-9-]+-v[0-9]+$"},
          "traffic_requests": {"type": "integer", "minimum": 1},
          "lifecycle": {
            "enum": [
              "current_immutable_version",
              "injected_immutable_version",
              "sequential_faulted_and_corrected_versions"
            ]
          },
          "window": {"$ref": "#/$defs/window"},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "severity", "finding_count", "validation_targets"],
            "properties": {
              "category": {
                "enum": [
                  "tool_call_failures",
                  "latency",
                  "cost_tokens",
                  "reliability_errors",
                  "hallucinations",
                  "output_quality",
                  "context_memory",
                  "safety_guardrails",
                  "none"
                ]
              },
              "severity": {"enum": ["high", "medium", "low", "none"]},
              "finding_count": {"type": "integer", "minimum": 0, "maximum": 4}
              ,
              "validation_targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scenario_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^aiq-scn-[0-9]{3}-[a-z][a-z0-9-]*$"
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^window://run-[0-9]{2}-aiq-[0-9]{3}-[a-z][a-z0-9-]*/[a-z-]+/start-inclusive$"
        },
        "end": {
          "type": "string",
          "pattern": "^window://run-[0-9]{2}-aiq-[0-9]{3}-[a-z][a-z0-9-]*/[a-z-]+/end-exclusive$"
        }
      }
    }
  }
}
