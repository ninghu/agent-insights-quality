{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "qualified", "human_reviewed", "quality_score", "quality_score_formula", "test_agent_model", "catalog_hashes", "artifact_manifest_hash", "version_content_digests", "deployment_manifest_hash", "qualification_manifest_hash", "source_integrity_digest", "report_reference"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "profile": {"const": "staging"},
    "qualified": {"const": true},
    "human_reviewed": {"const": true},
    "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
    "quality_score_formula": {"const": "correct_over_expected_plus_noise_v1"},
    "test_agent_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_name", "model_id", "model_version"],
      "properties": {
        "deployment_name": {"const": "gpt-5.4-mini"},
        "model_id": {"const": "gpt-5.4-mini"},
        "model_version": {"const": "2026-03-17"}
      }
    },
    "catalog_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "issues", "artifacts"],
      "properties": {
        "agents": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "issues": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifacts": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "artifact_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version_content_digests": {
      "type": "object",
      "minProperties": 41,
      "maxProperties": 41,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "deployment_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "qualification_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_integrity_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "report_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
