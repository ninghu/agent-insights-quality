{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "execution_id",
    "run_contract_digest",
    "phase",
    "target_count",
    "artifacts",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "daily-phase-manifest"},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_contract_digest": {"$ref": "#/$defs/hash"},
    "phase": {"enum": ["traffic", "verification", "insights"]},
    "target_count": {"const": 25},
    "artifacts": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_name", "logical_version", "path", "digest"],
        "properties": {
          "agent_name": {"type": "string", "minLength": 1},
          "logical_version": {"type": "string", "minLength": 2},
          "path": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "manifest_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
