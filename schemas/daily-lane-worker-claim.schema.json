{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "execution_id",
    "run_contract_digest",
    "agent_name",
    "reopen_event_digest",
    "epoch",
    "recovery_commit_sha",
    "recovery_verifier_digest",
    "worker_reference",
    "claim_nonce",
    "claim_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "daily-lane-worker-claim"},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_contract_digest": {"$ref": "#/$defs/hash"},
    "agent_name": {"$ref": "#/$defs/agent"},
    "reopen_event_digest": {"$ref": "#/$defs/hash"},
    "epoch": {"const": 1},
    "recovery_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "recovery_verifier_digest": {"$ref": "#/$defs/hash"},
    "worker_reference": {"$ref": "#/$defs/hash"},
    "claim_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "claim_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "agent": {
      "enum": [
        "weather-agent",
        "healthcare-agent",
        "finance-agent",
        "travel-agent",
        "support-ticket-agent"
      ]
    }
  }
}
