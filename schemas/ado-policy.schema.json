{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninghu.github.io/agent-insights-quality/schemas/v1/ado-policy.schema.json",
  "title": "Azure DevOps synchronization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "candidate_reporting_enabled",
    "auto_apply_enabled"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_version": {"const": "1.0.0"},
    "candidate_reporting_enabled": {"type": "boolean"},
    "auto_apply_enabled": {"type": "boolean"}
  }
}
