{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninghu/agent-insights-quality/schemas/test-agent-validation-approved-record.schema.json",
  "title": "Test Agent Validation approved record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "pr_number",
    "commit_sha",
    "validation_digest",
    "evidence_digest",
    "clean_digest",
    "approved_by",
    "approved_at",
    "record_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "test-agent-validation-approved-record"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr_number": {"type": "integer", "minimum": 1},
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "validation_digest": {"$ref": "#/$defs/hash"},
    "evidence_digest": {"$ref": "#/$defs/hash"},
    "clean_digest": {"$ref": "#/$defs/hash"},
    "approved_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
