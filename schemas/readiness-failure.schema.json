{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninghu.github.io/agent-insights-quality/schemas/v1/readiness-failure.schema.json",
  "title": "Readiness failure report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_date",
    "generated_at",
    "status",
    "failed_phase",
    "last_confirmed_stage",
    "reason",
    "incomplete_components",
    "prohibited_actions",
    "performed_actions",
    "diagnostics_reference",
    "safe_next_action",
    "email_handoff_reference"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^aiq-[0-9]{8}$"},
    "report_date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "INCONCLUSIVE"},
    "failed_phase": {"const": "runtime_readiness"},
    "last_confirmed_stage": {"const": "repository_contracts_loaded"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "incomplete_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "infrastructure",
          "healthy_agents",
          "scenario_catalog",
          "production_orchestrator",
          "deterministic_scoring",
          "copilot_judging",
          "quality_memory",
          "ado_synchronization",
          "reporting_and_email",
          "live_qualification"
        ]
      }
    },
    "prohibited_actions": {
      "const": [
        "azure_deployments",
        "agent_traffic",
        "agent_insights",
        "ado",
        "memory_transitions",
        "resource_cleanup",
        "generated_pr_mutation"
      ]
    },
    "performed_actions": {
      "oneOf": [
        {
          "const": [
            "render_failure_report",
            "render_failure_email",
            "create_email_handoff"
          ]
        },
        {
          "const": [
            "render_failure_report",
            "render_failure_email",
            "create_email_send_request"
          ]
        }
      ]
    },
    "diagnostics_reference": {"const": "config/runtime-readiness.yaml"},
    "safe_next_action": {"type": "string", "minLength": 1, "maxLength": 1000},
    "email_handoff_reference": {
      "enum": ["email-handoff.json", "email-send-request.json"]
    }
  }
}
