{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninghu/agent-insights-quality/schemas/test-agent-validation-judge-input.schema.json",
  "title": "Test Agent Validation judge input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "pr_number",
    "cycle_id",
    "commit_sha",
    "validation_digest",
    "runtime_topology_digest",
    "authority_id",
    "authority_kind",
    "canonical_agent",
    "logical_version",
    "scenario_id",
    "execution_digest",
    "validation_mode",
    "attempt_count",
    "model",
    "prompt_version",
    "prompt_digest",
    "reviewer_context",
    "subject_evidence",
    "paired_v0_evidence",
    "input_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "test-agent-validation-judge-input"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "cycle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "validation_digest": {"$ref": "#/$defs/hash"},
    "runtime_topology_digest": {"$ref": "#/$defs/hash"},
    "authority_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
        {"type": "string", "pattern": "^issue-[0-9]{3}$"}
      ]
    },
    "authority_kind": {"enum": ["baseline", "issue"]},
    "canonical_agent": {
      "enum": [
        "weather-agent",
        "healthcare-agent",
        "finance-agent",
        "travel-agent",
        "support-ticket-agent"
      ]
    },
    "logical_version": {
      "oneOf": [
        {"const": "v0"},
        {"type": "string", "pattern": "^issue-[0-9]{3}$"}
      ]
    },
    "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "execution_digest": {"$ref": "#/$defs/hash"},
    "validation_mode": {"enum": ["baseline", "deterministic", "model_mediated"]},
    "attempt_count": {"enum": [5, 7]},
    "model": {"const": "gpt-5.6-sol"},
    "prompt_version": {"const": "1.0.0"},
    "prompt_digest": {"$ref": "#/$defs/hash"},
    "reviewer_context": {"$ref": "#/$defs/reviewerContext"},
    "subject_evidence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/mechanicalEvidence"}
    },
    "paired_v0_evidence": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/mechanicalEvidence"}
        }
      ]
    },
    "input_digest": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"authority_kind": {"const": "baseline"}},
        "required": ["authority_kind"]
      },
      "then": {
        "properties": {
          "logical_version": {"const": "v0"},
          "validation_mode": {"const": "baseline"},
          "paired_v0_evidence": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "authority_id": {"pattern": "^issue-[0-9]{3}$"},
          "logical_version": {"pattern": "^issue-[0-9]{3}$"},
          "validation_mode": {"enum": ["deterministic", "model_mediated"]},
          "paired_v0_evidence": {
            "type": "array",
            "minItems": 5,
            "maxItems": 7,
            "items": {"$ref": "#/$defs/mechanicalEvidence"}
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewerContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_issue", "output_messages_expectation", "traffic_contract"],
      "properties": {
        "expected_issue": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "issue_id",
                "title",
                "root_cause",
                "category",
                "severity",
                "expected_fix"
              ],
              "properties": {
                "issue_id": {"type": "string", "pattern": "^issue-[0-9]{3}$"},
                "title": {"type": "string", "minLength": 1, "maxLength": 300},
                "root_cause": {"type": "string", "minLength": 1, "maxLength": 2000},
                "category": {"type": "string", "minLength": 1, "maxLength": 100},
                "severity": {"type": "string", "minLength": 1, "maxLength": 50},
                "expected_fix": {"type": "string", "minLength": 1, "maxLength": 2000}
              }
            }
          ]
        },
        "output_messages_expectation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "paired_v0"],
          "properties": {
            "subject": {"enum": ["present", "absent", "not_applicable"]},
            "paired_v0": {
              "oneOf": [
                {"type": "null"},
                {"const": "present"}
              ]
            }
          }
        },
        "traffic_contract": {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/trafficAttempt"}
        }
      }
    },
    "trafficAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_index", "request_digest", "setup_steps", "probe_steps"],
      "properties": {
        "attempt_index": {"type": "integer", "minimum": 1, "maximum": 7},
        "request_digest": {"$ref": "#/$defs/hash"},
        "setup_steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/trafficStep"}
        },
        "probe_steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/trafficStep"}
        }
      }
    },
    "trafficStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "request_digest",
        "semantic_expectations",
        "trace_expectations"
      ],
      "properties": {
        "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "request_digest": {"$ref": "#/$defs/hash"},
        "semantic_expectations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
        },
        "trace_expectations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
        }
      }
    },
    "mechanicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "attempt_index",
        "runtime_agent_reference",
        "runtime_version_reference",
        "event_range_reference",
        "endpoint",
        "trace_graph",
        "evidence_digest"
      ],
      "properties": {
        "role": {"enum": ["baseline", "issue", "paired_v0"]},
        "attempt_index": {"type": "integer", "minimum": 1, "maximum": 7},
        "runtime_agent_reference": {"$ref": "#/$defs/hash"},
        "runtime_version_reference": {"$ref": "#/$defs/hash"},
        "event_range_reference": {"$ref": "#/$defs/hash"},
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "request_count",
            "response_count",
            "usable_response_count",
            "terminal_output_count"
          ],
          "properties": {
            "citation": {"type": "string", "pattern": "^attempt-[0-9]{2}-endpoint$"},
            "request_count": {"type": "integer", "minimum": 1},
            "response_count": {"type": "integer", "minimum": 0},
            "usable_response_count": {"type": "integer", "minimum": 0},
            "terminal_output_count": {"type": "integer", "minimum": 0}
          }
        },
        "trace_graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_count", "nodes"],
          "properties": {
            "root_count": {"type": "integer", "minimum": 1},
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/traceNode"}
            }
          }
        },
        "evidence_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "traceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation",
        "parent",
        "order",
        "operation_name",
        "duration_bucket",
        "tool_name",
        "status_class",
        "result_class",
        "error_class",
        "output_messages_present",
        "output_messages_nonempty",
        "structure"
      ],
      "properties": {
        "citation": {"type": "string", "pattern": "^attempt-[0-9]{2}-trace-[0-9]{3,5}$"},
        "parent": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^attempt-[0-9]{2}-trace-[0-9]{3,5}$"}
          ]
        },
        "order": {"type": "integer", "minimum": 1},
        "operation_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "duration_bucket": {
          "enum": ["under_100ms", "100ms_to_1s", "1s_to_10s", "10s_to_60s", "over_60s"]
        },
        "tool_name": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}
          ]
        },
        "status_class": {"enum": ["success", "error", "unset"]},
        "result_class": {"enum": ["success", "error", "mixed", "none"]},
        "error_class": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}
          ]
        },
        "output_messages_present": {"type": ["boolean", "null"]},
        "output_messages_nonempty": {"type": ["boolean", "null"]},
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_present", "output_present", "result_present", "error_present"],
          "properties": {
            "input_present": {"type": "boolean"},
            "output_present": {"type": "boolean"},
            "result_present": {"type": "boolean"},
            "error_present": {"type": "boolean"}
          }
        }
      }
    }
  }
}
