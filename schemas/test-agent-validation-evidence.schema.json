{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninghu/agent-insights-quality/schemas/test-agent-validation-evidence.schema.json",
  "title": "Test Agent Validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "pr_number",
    "cycle_id",
    "commit_sha",
    "validation_digest",
    "execution_matrix_digest",
    "runtime_topology_digest",
    "resource_inventory_digest",
    "telemetry_resource_set",
    "judge_model",
    "judge_prompt_version",
    "judge_prompt_digest",
    "judge_input_digest",
    "judge_output_digest",
    "authorities",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "test-agent-validation-evidence"},
    "repository": {"$ref": "#/$defs/repository"},
    "pr_number": {"type": "integer", "minimum": 1},
    "cycle_id": {"$ref": "#/$defs/cycleId"},
    "commit_sha": {"$ref": "#/$defs/gitSha"},
    "validation_digest": {"$ref": "#/$defs/hash"},
    "execution_matrix_digest": {"$ref": "#/$defs/hash"},
    "runtime_topology_digest": {"$ref": "#/$defs/hash"},
    "resource_inventory_digest": {"$ref": "#/$defs/hash"},
    "telemetry_resource_set": {"const": "g29"},
    "judge_model": {"const": "gpt-5.6-sol"},
    "judge_prompt_version": {"const": "1.0.0"},
    "judge_prompt_digest": {"$ref": "#/$defs/hash"},
    "judge_input_digest": {"$ref": "#/$defs/hash"},
    "judge_output_digest": {"$ref": "#/$defs/hash"},
    "authorities": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authority"}
    },
    "evidence_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "cycleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_kind",
        "canonical_agent",
        "logical_version",
        "runtime_agent_name",
        "runtime_agent_version",
        "provider_agent_version_reference",
        "source_content_digest",
        "execution_digest",
        "predicate_contract_digest",
        "validated_commit_sha",
        "n",
        "k",
        "complete_count",
        "observed",
        "pass",
        "scenarios",
        "authority_evidence_digest"
      ],
      "properties": {
        "authority_id": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "authority_kind": {"enum": ["baseline", "issue"]},
        "canonical_agent": {
          "enum": [
            "weather-agent",
            "healthcare-agent",
            "finance-agent",
            "travel-agent",
            "support-ticket-agent"
          ]
        },
        "logical_version": {
          "oneOf": [
            {"const": "v0"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "runtime_agent_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "runtime_agent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_agent_version_reference": {"$ref": "#/$defs/hash"},
        "source_content_digest": {"$ref": "#/$defs/hash"},
        "execution_digest": {"$ref": "#/$defs/hash"},
        "predicate_contract_digest": {"$ref": "#/$defs/hash"},
        "validated_commit_sha": {"$ref": "#/$defs/gitSha"},
        "n": {"enum": [5, 7]},
        "k": {"const": 5},
        "complete_count": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0},
        "pass": {"type": "boolean"},
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/scenario"}
        },
        "authority_evidence_digest": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"authority_kind": {"const": "baseline"}},
            "required": ["authority_kind"]
          },
          "then": {
            "properties": {
              "authority_id": {"pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
              "logical_version": {"const": "v0"},
              "n": {"const": 5}
            }
          },
          "else": {
            "properties": {
              "authority_id": {"pattern": "^issue-[0-9]{3}$"},
              "logical_version": {"pattern": "^issue-[0-9]{3}$"}
            }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "execution_digest",
        "validation_mode",
        "healthy_predicate",
        "defect_predicate",
        "v0_control_predicate",
        "predicate_contract_digest",
        "n",
        "k",
        "complete_count",
        "observed",
        "pass",
        "issue_attempts",
        "v0_attempts"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "execution_digest": {"$ref": "#/$defs/hash"},
        "validation_mode": {
          "enum": ["baseline", "deterministic", "model_mediated"]
        },
        "healthy_predicate": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {"const": "all_probe_assertions_pass"}
              }
            }
          ]
        },
        "defect_predicate": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {"kind": {"const": "never"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "step_ids", "required_surfaces"],
              "properties": {
                "kind": {"const": "all_observation_steps_pass"},
                "step_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "required_surfaces": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {"enum": ["semantic", "trace"]}
                }
              }
            }
          ]
        },
        "v0_control_predicate": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {"const": "zero_defect_observations"}
              }
            }
          ]
        },
        "predicate_contract_digest": {"$ref": "#/$defs/hash"},
        "n": {"enum": [5, 7]},
        "k": {"const": 5},
        "complete_count": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0},
        "pass": {"type": "boolean"},
        "issue_attempts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/attempt"}
        },
        "v0_attempts": {
          "type": "array",
          "maxItems": 7,
          "items": {"$ref": "#/$defs/attempt"}
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "conversation_reference",
        "session_reference",
        "response_references",
        "operation_references",
        "mechanical_evidence",
        "setup_steps",
        "probe_steps",
        "complete",
        "defect_observed",
        "expected_observation_pass",
        "review_conclusion",
        "judge_input_digest",
        "judge_output_digest",
        "error_code"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 7},
        "conversation_reference": {"$ref": "#/$defs/hash"},
        "session_reference": {"$ref": "#/$defs/hash"},
        "response_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        },
        "operation_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        },
        "mechanical_evidence": {"$ref": "#/$defs/mechanicalEvidence"},
        "setup_steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "probe_steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "complete": {"type": "boolean"},
        "defect_observed": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "null"}
          ]
        },
        "expected_observation_pass": {"type": "boolean"},
        "review_conclusion": {
          "enum": ["observed", "not_observed", "inconclusive"]
        },
        "judge_input_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "judge_output_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "error_code": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_conclusion": {"const": "inconclusive"}
            },
            "required": ["review_conclusion"]
          },
          "then": {
            "properties": {
              "complete": {"const": false},
              "defect_observed": {"type": "null"},
              "judge_output_digest": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "complete": {"const": true},
              "defect_observed": {"type": "boolean"},
              "judge_input_digest": {"$ref": "#/$defs/hash"},
              "judge_output_digest": {"$ref": "#/$defs/hash"}
            }
          }
        }
      ]
    },
    "mechanicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "attempt_index",
        "runtime_agent_reference",
        "runtime_version_reference",
        "event_range_reference",
        "endpoint",
        "trace_graph",
        "evidence_digest"
      ],
      "properties": {
        "role": {"enum": ["baseline", "issue", "paired_v0"]},
        "attempt_index": {"type": "integer", "minimum": 1, "maximum": 7},
        "runtime_agent_reference": {"$ref": "#/$defs/hash"},
        "runtime_version_reference": {"$ref": "#/$defs/hash"},
        "event_range_reference": {"$ref": "#/$defs/hash"},
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "request_count",
            "response_count",
            "usable_response_count",
            "terminal_output_count"
          ],
          "properties": {
            "citation": {"type": "string", "pattern": "^attempt-[0-9]{2}-endpoint$"},
            "request_count": {"type": "integer", "minimum": 1},
            "response_count": {"type": "integer", "minimum": 0},
            "usable_response_count": {"type": "integer", "minimum": 0},
            "terminal_output_count": {"type": "integer", "minimum": 0}
          }
        },
        "trace_graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_count", "nodes"],
          "properties": {
            "root_count": {"type": "integer", "minimum": 1},
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/traceNode"}
            }
          }
        },
        "evidence_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "traceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation",
        "parent",
        "order",
        "operation_name",
        "duration_bucket",
        "tool_name",
        "status_class",
        "result_class",
        "error_class",
        "output_messages_present",
        "output_messages_nonempty",
        "structure"
      ],
      "properties": {
        "citation": {"type": "string", "pattern": "^attempt-[0-9]{2}-trace-[0-9]{3,5}$"},
        "parent": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^attempt-[0-9]{2}-trace-[0-9]{3,5}$"}
          ]
        },
        "order": {"type": "integer", "minimum": 1},
        "operation_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "duration_bucket": {
          "enum": ["under_100ms", "100ms_to_1s", "1s_to_10s", "10s_to_60s", "over_60s"]
        },
        "tool_name": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}
          ]
        },
        "status_class": {"enum": ["success", "error", "unset"]},
        "result_class": {"enum": ["success", "error", "mixed", "none"]},
        "error_class": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}
          ]
        },
        "output_messages_present": {"type": ["boolean", "null"]},
        "output_messages_nonempty": {"type": ["boolean", "null"]},
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_present", "output_present", "result_present", "error_present"],
          "properties": {
            "input_present": {"type": "boolean"},
            "output_present": {"type": "boolean"},
            "result_present": {"type": "boolean"},
            "error_present": {"type": "boolean"}
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "step_id",
        "request_digest",
        "response_reference",
        "operation_reference",
        "complete",
        "endpoint_pass",
        "semantic_pass",
        "trace_pass",
        "identity_pass"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$"
        },
        "request_digest": {"$ref": "#/$defs/hash"},
        "response_reference": {"$ref": "#/$defs/hash"},
        "operation_reference": {"$ref": "#/$defs/hash"},
        "complete": {"type": "boolean"},
        "endpoint_pass": {"type": "boolean"},
        "semantic_pass": {"type": "boolean"},
        "trace_pass": {"type": "boolean"},
        "identity_pass": {"type": "boolean"}
      }
    }
  }
}
