{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninghu/agent-insights-quality/schemas/test-agent-validation-evidence.schema.json",
  "title": "Test Agent Validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "pr_number",
    "cycle_id",
    "commit_sha",
    "validation_digest",
    "execution_matrix_digest",
    "runtime_topology_digest",
    "resource_inventory_digest",
    "environment_id",
    "location",
    "telemetry_resource_set",
    "authorities",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "test-agent-validation-evidence"},
    "repository": {"$ref": "#/$defs/repository"},
    "pr_number": {"type": "integer", "minimum": 1},
    "cycle_id": {"$ref": "#/$defs/cycleId"},
    "commit_sha": {"$ref": "#/$defs/gitSha"},
    "validation_digest": {"$ref": "#/$defs/hash"},
    "execution_matrix_digest": {"$ref": "#/$defs/hash"},
    "runtime_topology_digest": {"$ref": "#/$defs/hash"},
    "resource_inventory_digest": {"$ref": "#/$defs/hash"},
    "environment_id": {"const": "swedencentral-g30"},
    "location": {"const": "swedencentral"},
    "telemetry_resource_set": {"const": "g30"},
    "authorities": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authority"}
    },
    "evidence_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "cycleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_kind",
        "canonical_agent",
        "logical_version",
        "runtime_agent_name",
        "runtime_agent_version",
        "provider_agent_version_reference",
        "provider_content_digest",
        "source_content_digest",
        "execution_digest",
        "validated_commit_sha",
        "n",
        "complete_count",
        "pass",
        "scenarios",
        "authority_evidence_digest"
      ],
      "properties": {
        "authority_id": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "authority_kind": {"enum": ["baseline", "issue"]},
        "canonical_agent": {
          "enum": [
            "weather-agent",
            "healthcare-agent",
            "finance-agent",
            "travel-agent",
            "support-ticket-agent"
          ]
        },
        "logical_version": {
          "oneOf": [
            {"const": "v0"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "runtime_agent_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "runtime_agent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_agent_version_reference": {"$ref": "#/$defs/hash"},
        "provider_content_digest": {"$ref": "#/$defs/hash"},
        "source_content_digest": {"$ref": "#/$defs/hash"},
        "execution_digest": {"$ref": "#/$defs/hash"},
        "validated_commit_sha": {"$ref": "#/$defs/gitSha"},
        "n": {"enum": [5, 7]},
        "complete_count": {"type": "integer", "minimum": 0},
        "pass": {"type": "boolean"},
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/scenario"}
        },
        "authority_evidence_digest": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"authority_kind": {"const": "baseline"}},
            "required": ["authority_kind"]
          },
          "then": {
            "properties": {
              "authority_id": {"pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
              "logical_version": {"const": "v0"},
              "n": {"const": 5}
            }
          },
          "else": {
            "properties": {
              "authority_id": {"pattern": "^issue-[0-9]{3}$"},
              "logical_version": {"pattern": "^issue-[0-9]{3}$"}
            }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "execution_digest",
        "validation_mode",
        "n",
        "complete_count",
        "pass",
        "issue_attempts",
        "v0_attempts"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "execution_digest": {"$ref": "#/$defs/hash"},
        "validation_mode": {
          "enum": ["baseline", "deterministic", "model_mediated"]
        },
        "n": {"enum": [5, 7]},
        "complete_count": {"type": "integer", "minimum": 0},
        "pass": {"type": "boolean"},
        "issue_attempts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/attempt"}
        },
        "v0_attempts": {
          "type": "array",
          "maxItems": 7,
          "items": {"$ref": "#/$defs/attempt"}
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "conversation_reference",
        "session_reference",
        "response_references",
        "operation_references",
        "setup_steps",
        "probe_steps",
        "complete",
        "error_code"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 7},
        "conversation_reference": {"$ref": "#/$defs/hash"},
        "session_reference": {"$ref": "#/$defs/hash"},
        "response_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        },
        "operation_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        },
        "setup_steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "probe_steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "complete": {"type": "boolean"},
        "error_code": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$"
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "step_id",
        "request_digest",
        "response_reference",
        "operation_reference",
        "complete",
        "endpoint_pass",
        "identity_pass"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$"
        },
        "request_digest": {"$ref": "#/$defs/hash"},
        "response_reference": {"$ref": "#/$defs/hash"},
        "operation_reference": {"$ref": "#/$defs/hash"},
        "complete": {"type": "boolean"},
        "endpoint_pass": {"type": "boolean"},
        "identity_pass": {"type": "boolean"}
      }
    }
  }
}
