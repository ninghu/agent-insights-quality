{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/agent-insights-quality/schemas/v1/judgment.schema.json",
  "title": "Copilot semantic judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "judge_role",
    "model",
    "prompt_hash",
    "evidence_schema_version",
    "mapping",
    "verdict",
    "attributes",
    "relationships",
    "confidence",
    "reasoning",
    "output_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "format": "uuid"},
    "judge_role": {"enum": ["primary", "blinded_verifier"]},
    "model": {"const": "gpt-5.6-sol"},
    "prompt_hash": {"$ref": "#/$defs/sha256"},
    "evidence_schema_version": {"const": "1.0.0"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "insight_id"],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^aiq-scn-[0-9]{3}-[a-z][a-z0-9-]*$"
        },
        "insight_id": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "verdict": {"enum": ["correct", "partially_useful", "incorrect_noise"]},
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause",
        "title",
        "description",
        "proposed_fix",
        "category",
        "severity",
        "linked_traces",
        "meaningfulness"
      ],
      "properties": {
        "root_cause": {"$ref": "#/$defs/assessment"},
        "title": {"$ref": "#/$defs/assessment"},
        "description": {"$ref": "#/$defs/assessment"},
        "proposed_fix": {"$ref": "#/$defs/assessment"},
        "category": {"$ref": "#/$defs/assessment"},
        "severity": {"$ref": "#/$defs/assessment"},
        "linked_traces": {"$ref": "#/$defs/assessment"},
        "meaningfulness": {"$ref": "#/$defs/assessment"}
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicate_of", "fragmented_with", "umbrella_for"],
      "properties": {
        "duplicate_of": {"$ref": "#/$defs/id_list"},
        "fragmented_with": {"$ref": "#/$defs/id_list"},
        "umbrella_for": {"$ref": "#/$defs/id_list"}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reasoning": {"type": "string", "minLength": 1, "maxLength": 2000},
    "output_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passes", "reason"],
      "properties": {
        "passes": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  }
}
