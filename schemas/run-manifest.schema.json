{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile", "report_date", "insight_lookback_hours", "telemetry_resource_set", "catalog_hashes", "agents", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "pattern": "^aiq-[0-9]{8}(?:-r[0-9]{2})?$"},
    "profile": {"enum": ["daily", "staging"]},
    "report_date": {"type": "string", "format": "date"},
    "insight_lookback_hours": {"type": "number", "minimum": 0.1},
    "telemetry_resource_set": {"type": "string", "pattern": "^g[1-9][0-9]*$"},
    "catalog_hashes": {"type": "object"},
    "agents": {"type": "array", "minItems": 5, "maxItems": 5},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
