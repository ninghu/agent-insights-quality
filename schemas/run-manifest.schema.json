{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile", "delivery_mode", "report_date", "insight_lookback_hours", "telemetry_resource_set", "test_region", "test_region_registry", "catalog_hashes", "source_integrity", "agents", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "6.0.0"},
    "run_id": {"type": "string", "pattern": "^aiq-[0-9]{8}(?:-r[0-9]{2,})?$"},
    "profile": {"enum": ["daily", "staging"]},
    "delivery_mode": {"enum": ["official", "test_email_only"]},
    "report_date": {"type": "string", "format": "date"},
    "insight_lookback_hours": {"type": "number", "minimum": 0.1},
    "telemetry_resource_set": {"type": "string", "pattern": "^g[1-9][0-9]*$"},
    "test_region": {"type": "string", "pattern": "^[A-Z][A-Za-z]*[0-9]*$"},
    "test_region_registry": {"type": "string", "pattern": "^[A-Z][A-Za-z]*[0-9]*$"},
    "catalog_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "issues", "artifacts"],
      "properties": {
        "agents": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "issues": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifacts": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "source_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "contract_digest"],
      "properties": {
        "verified": {"const": true},
        "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "phase_manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traffic", "verification", "insights"],
      "properties": {
        "traffic": {"$ref": "#/$defs/artifactReference"},
        "verification": {"$ref": "#/$defs/artifactReference"},
        "insights": {"$ref": "#/$defs/artifactReference"}
      }
    },
    "agents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "framework", "baseline_contract", "monitor_reference", "baseline", "issues"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["prompt", "hosted_code", "hosted_custom_container"]},
          "framework": {"enum": ["foundry_prompt", "microsoft_agent_framework", "langgraph", "custom_responses"]},
          "baseline_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["request_count", "terminal_response", "semantic_assertions", "function_calling", "trace_operations", "validation_mode"],
            "properties": {
              "request_count": {"const": 10},
              "terminal_response": {"enum": ["direct_prompt", "standard_assistant_message", "explicit_span_attributes"]},
              "semantic_assertions": {"enum": ["required", "required_per_request"]},
              "function_calling": {"enum": ["forbidden", "not_applicable"]},
              "trace_operations": {"enum": ["uniform", "required_per_request"]},
              "validation_mode": {"const": "baseline"}
            }
          },
          "monitor_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "baseline": {"$ref": "#/$defs/baselineEvidence"},
          "issues": {
            "type": "array",
            "items": {"$ref": "#/$defs/issueEvidence"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "prompt"}}},
            "then": {
              "properties": {
                "baseline_contract": {
                  "properties": {
                    "terminal_response": {"const": "direct_prompt"},
                    "semantic_assertions": {"const": "required_per_request"},
                    "function_calling": {"const": "forbidden"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "hosted_code"}}},
            "then": {
              "properties": {
                "baseline_contract": {
                  "properties": {
                    "terminal_response": {"const": "standard_assistant_message"},
                    "function_calling": {"const": "not_applicable"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "hosted_custom_container"}}},
            "then": {
              "properties": {
                "baseline_contract": {
                  "properties": {
                    "terminal_response": {"const": "explicit_span_attributes"},
                    "function_calling": {"const": "not_applicable"}
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {"const": "support-ticket-agent"}
              }
            },
            "then": {
              "properties": {
                "baseline_contract": {
                  "properties": {
                    "trace_operations": {"const": "required_per_request"}
                  }
                }
              }
            },
            "else": {
              "properties": {
                "baseline_contract": {
                  "properties": {
                    "trace_operations": {"const": "uniform"}
                  }
                }
              }
            }
          }
        ]
      }
    },
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "baselineEvidence": {
      "allOf": [
        {"$ref": "#/$defs/versionEvidence"},
        {
          "properties": {
            "logical_version": {"const": "v0"},
            "status": {"enum": ["passed", "not_at_bar", "inconclusive"]},
            "validation_mode": {"const": "baseline"},
            "n": {"const": 10},
            "k": {"const": 6},
            "trace_unknown_acceptance": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/traceUnknownAcceptance"}
              ]
            }
          },
          "not": {
            "anyOf": [
              {"required": ["issue_id"]},
              {"required": ["required_surfaces"]}
            ]
          }
        }
      ]
    },
    "issueEvidence": {
      "allOf": [
        {"$ref": "#/$defs/versionEvidence"},
        {
          "required": ["issue_id", "required_surfaces"],
          "properties": {
            "issue_id": {"type": "string", "pattern": "^issue-[0-9]{3}$"},
            "logical_version": {"type": "string", "pattern": "^issue-[0-9]{3}$"},
            "status": {"enum": ["observed", "not_at_bar", "inconclusive", "skipped_baseline"]},
            "validation_mode": {"enum": ["deterministic", "model_mediated"]},
            "n": {"const": 10},
            "k": {"const": 6}
          }
        }
      ]
    },
    "versionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_version",
        "foundry_version",
        "content_digest",
        "validation_mode",
        "n",
        "k",
        "execution_digest",
        "status",
        "operation_ids",
        "insight_references",
        "window_start",
        "window_end",
        "error_code",
        "endpoint_request_count",
        "endpoint_response_count",
        "endpoint_usable_response_count",
        "semantic_assertion_count",
        "semantic_assertions_passed",
        "trace_assertion_count",
        "trace_assertions_passed",
        "trace_contract_verified",
        "trace_behavior_summary",
        "trace_maturity_proof",
        "trace_unknown_acceptance",
        "endpoint_request_summaries",
        "evidence_reference"
      ],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^issue-[0-9]{3}$"},
        "logical_version": {
          "anyOf": [
            {"const": "v0"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "foundry_version": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "validation_mode": {
          "enum": ["baseline", "deterministic", "model_mediated"]
        },
        "n": {"const": 10},
        "k": {"const": 6},
        "execution_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "required_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["semantic", "trace"]}
        },
        "status": {"enum": ["passed", "not_at_bar", "observed", "inconclusive", "skipped_baseline"]},
        "operation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
        },
        "insight_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "window_start": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "window_end": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "error_code": {"type": ["string", "null"]},
        "endpoint_request_count": {"type": "integer", "minimum": 0},
        "endpoint_response_count": {"type": "integer", "minimum": 0},
        "endpoint_usable_response_count": {"type": "integer", "minimum": 0},
        "semantic_assertion_count": {"type": "integer", "minimum": 0},
        "semantic_assertions_passed": {"type": "integer", "minimum": 0},
        "trace_assertion_count": {"type": "integer", "minimum": 0},
        "trace_assertions_passed": {"type": "integer", "minimum": 0},
        "trace_contract_verified": {"type": "boolean"},
        "trace_behavior_summary": {"$ref": "#/$defs/traceBehaviorSummary"},
        "trace_maturity_proof": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/traceMaturityProof"}
          ]
        },
        "trace_unknown_acceptance": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/traceUnknownAcceptance"}
          ]
        },
        "endpoint_request_summaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_index",
              "response_count",
              "usable_response",
              "semantic_assertion_count",
              "semantic_assertions_passed",
              "assertion_results",
              "trace_assertion_count",
              "trace_assertions_passed",
              "trace_assertion_results",
              "activation_gate",
              "direct_terminal_response_count",
              "function_call_count",
              "error_code"
            ],
            "properties": {
              "request_index": {"type": "integer", "minimum": 0},
              "response_count": {"type": "integer", "minimum": 0},
              "usable_response": {"type": "boolean"},
              "semantic_assertion_count": {"type": "integer", "minimum": 0},
              "semantic_assertions_passed": {"type": "integer", "minimum": 0},
              "assertion_results": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["assertion", "passed", "evidence_sufficient"],
                  "properties": {
                    "assertion": {"type": "string", "minLength": 1},
                    "passed": {"type": "boolean"},
                    "evidence_sufficient": {"type": "boolean"}
                  }
                }
              },
              "trace_assertion_count": {"type": "integer", "minimum": 0},
              "trace_assertions_passed": {"type": "integer", "minimum": 0},
              "trace_assertion_results": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["assertion", "passed", "evidence_sufficient"],
                  "properties": {
                    "assertion": {"type": "string", "minLength": 1},
                    "passed": {"type": "boolean"},
                    "evidence_sufficient": {"type": "boolean"}
                  }
                }
              },
              "activation_gate": {"type": "boolean"},
              "direct_terminal_response_count": {"type": "integer", "minimum": 0, "maximum": 1},
              "function_call_count": {"type": "integer", "minimum": 0},
              "error_code": {
                "type": ["string", "null"],
                "enum": [null, "missing_evidence", "assertion_failed"]
              }
            }
          }
        },
        "evidence_reference": {
          "oneOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "traceUnknownAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "target_role",
        "observation_count",
        "unknown_attempt_indices",
        "maturity_proof_digest"
      ],
      "properties": {
        "policy": {"const": "mature_trace_unknown_v1"},
        "target_role": {"enum": ["baseline", "issue", "paired_v0"]},
        "observation_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "unknown_attempt_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 10}
        },
        "maturity_proof_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "traceBehaviorSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_count": {"type": "integer", "minimum": 0},
        "tool_call_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "tool_response_count": {"type": "integer", "minimum": 0},
        "successful_tool_response_count": {"type": "integer", "minimum": 0},
        "error_codes": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "assistant_response_count": {"type": "integer", "minimum": 0},
        "explicit_terminal_success_count": {"type": "integer", "minimum": 0},
        "explicit_terminal_output_count": {"type": "integer", "minimum": 0},
        "terminal_success_count": {"type": "integer", "minimum": 0},
        "terminal_output_count": {"type": "integer", "minimum": 0},
        "terminal_response_count": {"type": "integer", "minimum": 0},
        "handled_error_count": {"type": "integer", "minimum": 0},
        "unhandled_error_count": {"type": "integer", "minimum": 0}
      }
    },
    "traceMaturityProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "evidence_window_start",
        "evidence_window_end",
        "maturity_boundary",
        "snapshot_observed_at",
        "maximum_hydration_seconds",
        "stabilization_seconds",
        "maturity_proof_digest"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "kind": {"const": "daily-trace-maturity-proof"},
        "evidence_window_start": {"type": "string", "format": "date-time"},
        "evidence_window_end": {"type": "string", "format": "date-time"},
        "maturity_boundary": {"type": "string", "format": "date-time"},
        "snapshot_observed_at": {"type": "string", "format": "date-time"},
        "maximum_hydration_seconds": {"type": "integer", "minimum": 1},
        "stabilization_seconds": {"type": "integer", "minimum": 1},
        "maturity_proof_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
