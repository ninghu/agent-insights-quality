{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile", "report_date", "catalog_hashes", "agents", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^aiq-[0-9]{8}(?:-r[0-9]{2})?$"},
    "profile": {"enum": ["daily", "staging"]},
    "report_date": {"type": "string", "format": "date"},
    "catalog_hashes": {"type": "object"},
    "agents": {"type": "array", "minItems": 5, "maxItems": 5},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
