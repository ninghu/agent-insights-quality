{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninghu.github.io/agent-insights-quality/schemas/v1/canonical-report.schema.json",
  "title": "Canonical Agent Insights daily report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_date",
    "generated_at",
    "plan_id",
    "status",
    "summary",
    "engine",
    "scorecard",
    "agents",
    "scenario_results",
    "field_judgments",
    "collection_analysis",
    "diagnostics",
    "bug_actions",
    "memory_changes",
    "artifact_reference",
    "failure",
    "delivery"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "report_id": {"type": "string", "pattern": "^aiq-[0-9]{8}(?:-r[0-9]{2})?$"},
    "report_date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "plan_id": {"type": "string", "pattern": "^aiq-[0-9]{8}(?:-r[0-9]{2})?$"},
    "status": {"enum": ["AT BAR", "NOT AT BAR", "INCONCLUSIVE"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "bar_definition": {"$ref": "#/$defs/bar_definition"},
    "human_validation_checklists": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/human_validation_checklist"}
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "generator_model", "endpoint_reference"],
      "properties": {
        "build": {"type": "string", "minLength": 1, "maxLength": 200},
        "generator_model": {"const": "gpt-5.6-terra"},
        "endpoint_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "scorecard": {
      "type": "object",
      "description": "A value validated independently against scorecard.schema.json."
    },
    "agents": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "version_digest", "insights_reference", "human_validation"],
        "properties": {
          "id": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*.*$"},
          "type": {"enum": ["prompt", "hosted_code", "hosted_custom_container"]},
          "version_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "insights_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "human_validation": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "scenario_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "agent_id",
          "run_id",
          "version_sequence",
          "agent_version_digest",
          "completed",
          "expected_count",
          "observed_count",
          "verdict",
          "insight_references"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^aiq-scn-[0-9]{3}-[a-z][a-z0-9-]*$"
          },
          "agent_id": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
          "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "version_sequence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "version_digest"],
            "properties": {
              "phase": {
                "enum": ["healthy", "faulted", "faulted-initial", "faulted-repeat", "corrected", "recurred"]
              },
              "version_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          },
          "agent_version_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "completed": {"type": "boolean"},
          "expected_count": {"type": "integer", "minimum": 0},
          "observed_count": {"type": "integer", "minimum": 0},
          "verdict": {
            "enum": ["correct", "partially_useful", "incorrect_noise", "missed", "mixed", "inconclusive"]
          },
          "insight_references": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "field_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "insight_reference",
          "verdict",
          "confidence",
          "verifier_verdict",
          "verifier_confidence",
          "novel",
          "fix_verifiable",
          "attributes",
          "relationships",
          "stale_version"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^aiq-scn-[0-9]{3}-[a-z][a-z0-9-]*$"
          },
          "insight_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "verdict": {"enum": ["correct", "partially_useful", "incorrect_noise"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "verifier_verdict": {
            "type": ["string", "null"],
            "enum": ["correct", "partially_useful", "incorrect_noise", null]
          },
          "verifier_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "novel": {"type": "boolean"},
          "fix_verifiable": {"type": "boolean"},
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root_cause",
              "title",
              "description",
              "proposed_fix",
              "category",
              "severity",
              "linked_traces",
              "meaningfulness",
              "evidence_localization",
              "actionability"
            ],
            "properties": {
              "root_cause": {"type": "boolean"},
              "title": {"type": "boolean"},
              "description": {"type": "boolean"},
              "proposed_fix": {"type": "boolean"},
              "category": {"type": "boolean"},
              "severity": {"type": "boolean"},
              "linked_traces": {"type": "boolean"},
              "meaningfulness": {"type": "boolean"},
              "evidence_localization": {"type": "boolean"},
              "actionability": {"type": "boolean"}
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duplicate", "fragment", "umbrella"],
            "properties": {
              "duplicate": {"type": "boolean"},
              "fragment": {"type": "boolean"},
              "umbrella": {"type": "boolean"}
            }
          },
          "stale_version": {"type": "boolean"}
        }
      }
    },
    "collection_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinct", "duplicates", "fragments", "umbrellas", "stale_version"],
      "properties": {
        "distinct": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "fragments": {"type": "integer", "minimum": 0},
        "umbrellas": {"type": "integer", "minimum": 0},
        "stale_version": {"type": "integer", "minimum": 0}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_latency_ms", "model_calls", "tokens"],
      "properties": {
        "engine_latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "model_calls": {"type": ["integer", "null"], "minimum": 0},
        "tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "bug_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "action",
          "work_item_reference",
          "policy_snapshot",
          "apply_receipt"
        ],
        "properties": {
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "action": {"enum": ["candidate", "created", "updated", "reopened", "commented", "none"]},
          "work_item_reference": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "policy_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy_version", "auto_apply_enabled"],
            "properties": {
              "policy_version": {"const": "1.0.0"},
              "auto_apply_enabled": {"type": "boolean"}
            }
          },
          "apply_receipt": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["confirmed", "operation_reference", "work_item_reference"],
                "properties": {
                  "confirmed": {"const": true},
                  "operation_reference": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "work_item_reference": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "memory_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "from", "to"],
        "properties": {
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "from": {"type": ["string", "null"], "enum": [null, "new", "known", "improving", "resolved", "regressed"]},
          "to": {"enum": ["new", "known", "improving", "resolved", "regressed"]}
        }
      }
    },
    "artifact_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failed_phase",
            "last_confirmed_stage",
            "reason",
            "affected_agents",
            "diagnostics_reference",
            "next_action"
          ],
          "properties": {
            "failed_phase": {"type": "string", "minLength": 1, "maxLength": 200},
            "last_confirmed_stage": {"type": "string", "minLength": 1, "maxLength": 500},
            "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
            "affected_agents": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"}
            },
            "diagnostics_reference": {
              "type": ["string", "null"],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "next_action": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "request_reference"],
      "properties": {
        "state": {"enum": ["unsent", "sent", "failed"]},
        "request_reference": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
    "allOf": [
      {
        "if": {
          "properties": {"schema_version": {"const": "1.1.0"}},
          "required": ["schema_version"]
        },
        "then": {
          "required": ["bar_definition", "human_validation_checklists"]
        }
      }
    ],
    "$defs": {
          "rate": {"type": "number", "minimum": 0, "maximum": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bar_definition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["thresholds", "actuals", "gates"],
            "properties": {
              "thresholds": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exact_expected_observed_per_run",
                  "high_severity_recall_required",
                  "overall_recall_minimum",
                  "precision_minimum",
                  "required_field_correctness",
                  "duplication_rate_maximum",
                  "fragmentation_rate_maximum",
                  "umbrella_rate_maximum",
                  "cross_version_stale_rate_maximum",
                  "healthy_insights_maximum",
                  "capability_fix_mismatches_maximum",
                  "trust_failures_allowed"
                ],
                "properties": {
                  "exact_expected_observed_per_run": {"const": true},
                  "high_severity_recall_required": {"const": 1.0},
                  "overall_recall_minimum": {"const": 0.9},
                  "precision_minimum": {"const": 0.95},
                  "required_field_correctness": {"const": 1.0},
                  "duplication_rate_maximum": {"const": 0.0},
                  "fragmentation_rate_maximum": {"const": 0.0},
                  "umbrella_rate_maximum": {"const": 0.0},
                  "cross_version_stale_rate_maximum": {"const": 0.0},
                  "healthy_insights_maximum": {"const": 0},
                  "capability_fix_mismatches_maximum": {"const": 0},
                  "trust_failures_allowed": {"const": false}
                }
              },
              "actuals": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_findings",
                  "observed_findings",
                  "count_mismatch_runs",
                  "high_severity_recall",
                  "overall_recall",
                  "precision",
                  "required_field_correctness",
                  "duplication_rate",
                  "fragmentation_rate",
                  "umbrella_rate",
                  "cross_version_stale_rate",
                  "healthy_insights",
                  "capability_fix_mismatches",
                  "trust_failures"
                ],
                "properties": {
                  "expected_findings": {"type": "integer", "minimum": 0},
                  "observed_findings": {"type": "integer", "minimum": 0},
                  "count_mismatch_runs": {"type": "integer", "minimum": 0},
                  "high_severity_recall": {"$ref": "#/$defs/rate"},
                  "overall_recall": {"$ref": "#/$defs/rate"},
                  "precision": {"$ref": "#/$defs/rate"},
                  "required_field_correctness": {"$ref": "#/$defs/rate"},
                  "duplication_rate": {"$ref": "#/$defs/rate"},
                  "fragmentation_rate": {"$ref": "#/$defs/rate"},
                  "umbrella_rate": {"$ref": "#/$defs/rate"},
                  "cross_version_stale_rate": {"$ref": "#/$defs/rate"},
                  "healthy_insights": {"type": "integer", "minimum": 0},
                  "capability_fix_mismatches": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "trust_failures": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "structural_failure",
                        "provenance_failure",
                        "secret_or_pii",
                        "judge_schema_failure",
                        "unresolved_judgment"
                      ]
                    }
                  }
                }
              },
              "gates": {
                "type": "array",
                "minItems": 12,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "passed", "explanation"],
                  "properties": {
                    "id": {
                      "enum": [
                        "exact_run_counts",
                        "high_severity_recall",
                        "overall_recall",
                        "precision",
                        "required_fields",
                        "duplicate_relationships",
                        "fragment_relationships",
                        "umbrella_relationships",
                        "stale_relationships",
                        "healthy_controls",
                        "capability_compatibility",
                        "trusted_evidence"
                      ]
                    },
                    "passed": {"type": "boolean"},
                    "explanation": {"type": "string", "minLength": 1, "maxLength": 500}
                  }
                }
              }
            }
          },
          "human_validation_checklist": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "review_reason",
              "standard_checks",
              "versions",
              "human_outcome"
            ],
            "properties": {
              "agent_id": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
              "review_reason": {"type": "string", "minLength": 1, "maxLength": 500},
              "standard_checks": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": {"type": "string", "minLength": 1, "maxLength": 300}
              },
              "versions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run_id",
                    "sequence_index",
                    "phase",
                    "version_key",
                    "version_digest",
                    "expected_insight_count",
                    "expected_scenarios",
                    "observed_final_cards",
                    "planned_prior_evidence",
                    "double_check"
                  ],
                  "properties": {
                    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
                    "sequence_index": {"type": "integer", "minimum": 0, "maximum": 20},
                    "phase": {
                      "enum": [
                        "healthy",
                        "faulted",
                        "faulted-initial",
                        "faulted-repeat",
                        "corrected",
                        "recurred"
                      ]
                    },
                    "version_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                    "version_digest": {"$ref": "#/$defs/sha256"},
                    "expected_insight_count": {"type": "integer", "minimum": 0, "maximum": 100},
                    "expected_scenarios": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "scenario_id",
                          "title",
                          "root_cause",
                          "category",
                          "severity",
                          "expected_insight_count"
                        ],
                        "properties": {
                          "scenario_id": {
                            "type": "string",
                            "pattern": "^aiq-scn-[0-9]{3}-[a-z][a-z0-9-]*$"
                          },
                          "title": {"type": "string", "minLength": 1, "maxLength": 300},
                          "root_cause": {"type": "string", "minLength": 1, "maxLength": 1000},
                          "category": {
                            "enum": [
                              "tool_call_failures",
                              "latency",
                              "cost_tokens",
                              "reliability_errors",
                              "hallucinations",
                              "output_quality",
                              "context_memory",
                              "safety_guardrails",
                              "none"
                            ]
                          },
                          "severity": {"enum": ["high", "medium", "low", "none"]},
                          "expected_insight_count": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4
                          }
                        }
                      }
                    },
                    "observed_final_cards": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["scenario_id", "insight_reference", "verdict"],
                        "properties": {
                          "scenario_id": {
                            "type": "string",
                            "pattern": "^aiq-scn-[0-9]{3}-[a-z][a-z0-9-]*$"
                          },
                          "insight_reference": {"$ref": "#/$defs/sha256"},
                          "verdict": {
                            "enum": [
                              "correct",
                              "partially_useful",
                              "incorrect_noise",
                              "missed",
                              "mixed",
                              "inconclusive"
                            ]
                          }
                        }
                      }
                    },
                    "planned_prior_evidence": {"type": "boolean"},
                    "double_check": {"type": "string", "minLength": 1, "maxLength": 500}
                  }
                }
              },
              "human_outcome": {"const": "not_recorded"}
            }
          }
        }
}
