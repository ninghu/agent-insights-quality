{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninghu.github.io/agent-insights-quality/schemas/v1/email-handoff.schema.json",
  "title": "Copilot direct-email handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_date",
    "required",
    "message_count",
    "recipient_variable",
    "allowed_domain",
    "sender_context",
    "transport",
    "subject",
    "html_artifact",
    "delivery"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^aiq-[0-9]{8}$"},
    "report_date": {"type": "string", "format": "date"},
    "required": {"const": true},
    "message_count": {"const": 1},
    "recipient_variable": {"const": "AIQ_TEST_REPORT_RECIPIENT"},
    "allowed_domain": {"const": "microsoft.com"},
    "sender_context": {"const": "authenticated_user_mailbox"},
    "transport": {"const": "copilot_connected_microsoft_mail"},
    "subject": {
      "type": "string",
      "pattern": "^\\[Agent Insights Quality\\] INCONCLUSIVE - [0-9]{4}-[0-9]{2}-[0-9]{2} - .+$",
      "maxLength": 300
    },
    "html_artifact": {"const": "failure-email.html"},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_reference", "error_code"],
      "properties": {
        "status": {"enum": ["pending", "sent", "failed"]},
        "receipt_reference": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "error_code": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]{0,99}$"
        }
      }
    }
  }
}
