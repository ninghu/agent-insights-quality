{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_name", "model", "package_hash", "foundry_version", "verdict", "ownership", "ownership_reason", "card_evaluations", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "agent_name": {"enum": ["weather-agent", "healthcare-agent", "finance-agent", "travel-agent", "support-ticket-agent"]},
    "model": {"const": "gpt-5.6-sol"},
    "package_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "foundry_version": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["clean", "noise", "agent_finding", "inconclusive"]},
    "ownership": {"enum": ["none", "agent", "insight_engine", "test_framework", "infrastructure", "unresolved"]},
    "ownership_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "card_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "title", "category", "severity", "evaluation", "ownership", "ownership_reason", "confidence", "reasoning"],
        "properties": {
          "reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "title": {"type": "string", "maxLength": 300},
          "category": {"type": "string", "maxLength": 100},
          "severity": {"type": "string", "maxLength": 50},
          "evaluation": {"enum": ["noise", "valid_agent_finding", "incomplete"]},
          "ownership": {"enum": ["agent", "insight_engine", "test_framework", "infrastructure", "unresolved"]},
          "ownership_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reasoning": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
