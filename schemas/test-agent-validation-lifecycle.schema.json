{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninghu/agent-insights-quality/schemas/test-agent-validation-lifecycle.schema.json",
  "title": "Test Agent Validation local lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "snapshot_type",
    "cycle_id",
    "revision",
    "state",
    "repository",
    "pr_number",
    "commit_sha",
    "digests",
    "operator",
    "substrate",
    "ownership_nonce",
    "capacity",
    "project",
    "runtime_topology",
    "deployment",
    "resources",
    "cleanup",
    "event_reference",
    "clean_reference",
    "evidence_reference",
    "started_at",
    "last_activity_at",
    "absolute_expires_at",
    "failure",
    "previous_journal_digest",
    "journal_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "test-agent-validation-lifecycle"},
    "snapshot_type": {"enum": ["active", "event", "clean"]},
    "cycle_id": {"$ref": "#/$defs/cycleId"},
    "revision": {"type": "integer", "minimum": 1},
    "state": {
      "enum": [
        "LOCKED",
        "PREFLIGHT",
        "CREATING",
        "VALIDATING",
        "FINAL_CHECKS",
        "CLEANING",
        "CLEAN",
        "FAILED_CLEAN",
        "CLEANUP_BLOCKED"
      ]
    },
    "repository": {"$ref": "#/$defs/repository"},
    "pr_number": {"type": "integer", "minimum": 1},
    "commit_sha": {"$ref": "#/$defs/gitSha"},
    "digests": {"$ref": "#/$defs/digests"},
    "operator": {"$ref": "#/$defs/operator"},
    "substrate": {"$ref": "#/$defs/substrate"},
    "ownership_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "capacity": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/capacity"}
      ]
    },
    "project": {"$ref": "#/$defs/project"},
    "runtime_topology": {"$ref": "#/$defs/runtimeTopology"},
    "deployment": {"$ref": "#/$defs/deployment"},
    "resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resource"}
    },
    "cleanup": {"$ref": "#/$defs/cleanup"},
    "event_reference": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/snapshotReference"}
      ]
    },
    "clean_reference": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/snapshotReference"}
      ]
    },
    "evidence_reference": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/snapshotReference"}
      ]
    },
    "started_at": {"$ref": "#/$defs/timestamp"},
    "last_activity_at": {"$ref": "#/$defs/timestamp"},
    "absolute_expires_at": {"$ref": "#/$defs/timestamp"},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/failure"}
      ]
    },
    "previous_journal_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/hash"}
      ]
    },
    "journal_digest": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"snapshot_type": {"const": "active"}},
        "required": ["snapshot_type"]
      },
      "then": {
        "properties": {
          "event_reference": {"$ref": "#/$defs/snapshotReference"}
        }
      },
      "else": {
        "properties": {"event_reference": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {"snapshot_type": {"const": "clean"}},
        "required": ["snapshot_type"]
      },
      "then": {
        "properties": {"clean_reference": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {
          "snapshot_type": {"const": "active"},
          "state": {"enum": ["CLEAN", "FAILED_CLEAN"]}
        },
        "required": ["snapshot_type", "state"]
      },
      "then": {
        "properties": {
          "clean_reference": {"$ref": "#/$defs/snapshotReference"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "FINAL_CHECKS",
              "CLEAN"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "evidence_reference": {"$ref": "#/$defs/snapshotReference"}
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "cycleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "nullableReference": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/reference"}
      ]
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_digest",
        "execution_matrix_digest",
        "runtime_topology_digest",
        "quota_plan_digest",
        "evidence_digest",
        "evidence_resource_inventory_digest",
        "clean_resource_inventory_digest"
      ],
      "properties": {
        "validation_digest": {"$ref": "#/$defs/hash"},
        "execution_matrix_digest": {"$ref": "#/$defs/hash"},
        "runtime_topology_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "quota_plan_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "evidence_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "evidence_resource_inventory_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "clean_resource_inventory_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_reference",
        "operator_reference",
        "run_reference"
      ],
      "properties": {
        "session_reference": {"$ref": "#/$defs/hash"},
        "operator_reference": {"$ref": "#/$defs/hash"},
        "run_reference": {"$ref": "#/$defs/hash"}
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "subscription_id",
        "account_name",
        "account_resource_id",
        "registry_name",
        "storage_account_name",
        "telemetry_resource_id"
      ],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/reference"},
        "subscription_id": {"$ref": "#/$defs/reference"},
        "account_name": {"$ref": "#/$defs/reference"},
        "account_resource_id": {"$ref": "#/$defs/reference"},
        "registry_name": {"$ref": "#/$defs/reference"},
        "storage_account_name": {"$ref": "#/$defs/reference"},
        "telemetry_resource_id": {"$ref": "#/$defs/reference"}
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_rpm",
        "measured_tpm",
        "measured_at",
        "reserved_percent",
        "reserved_rpm",
        "reserved_tpm",
        "available_rpm",
        "available_tpm",
        "outer_request_envelope",
        "worst_case_inner_model_calls",
        "worst_case_inner_tokens",
        "endpoint_concurrency",
        "provisioning_concurrency",
        "telemetry_query_concurrency",
        "runtime_attempt_concurrency",
        "inner_model_call_limit",
        "plan_digest"
      ],
      "properties": {
        "measured_rpm": {"type": "integer", "minimum": 1},
        "measured_tpm": {"type": "integer", "minimum": 1},
        "measured_at": {"$ref": "#/$defs/timestamp"},
        "reserved_percent": {"const": 25},
        "reserved_rpm": {"type": "integer", "minimum": 8},
        "reserved_tpm": {"type": "integer", "minimum": 8192},
        "available_rpm": {"type": "integer", "minimum": 1},
        "available_tpm": {"type": "integer", "minimum": 1},
        "outer_request_envelope": {"type": "integer", "minimum": 1},
        "worst_case_inner_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "worst_case_inner_tokens": {"type": "integer", "minimum": 1},
        "endpoint_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "provisioning_concurrency": {"const": 8},
        "telemetry_query_concurrency": {"const": 4},
        "runtime_attempt_concurrency": {"const": 1},
        "inner_model_call_limit": {"const": 4},
        "plan_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider_id",
        "endpoint_reference",
        "state",
        "create_intent_at",
        "create_observed_at",
        "delete_intent_at",
        "delete_observed_at"
      ],
      "properties": {
        "name": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$"
            }
          ]
        },
        "provider_id": {"$ref": "#/$defs/nullableReference"},
        "endpoint_reference": {"$ref": "#/$defs/nullableReference"},
        "state": {"enum": ["absent", "create_intent", "created", "delete_intent", "deleted"]},
        "create_intent_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "create_observed_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "delete_intent_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "delete_observed_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        }
      }
    },
    "runtimeTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_reference",
        "project_reference",
        "telemetry_resource_set",
        "test_agent_model",
        "name_policy",
        "connection_ids",
        "runtime_principal_ids",
        "telemetry_identity_ids",
        "agents"
      ],
      "properties": {
        "account_reference": {"$ref": "#/$defs/reference"},
        "project_reference": {"$ref": "#/$defs/nullableReference"},
        "telemetry_resource_set": {"const": "g29"},
        "test_agent_model": {
          "const": {
            "deployment_name": "gpt-5.4-mini",
            "model_id": "gpt-5.4-mini",
            "model_version": "2026-03-17"
          }
        },
        "name_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_maximum_length",
            "agent_maximum_length",
            "pattern"
          ],
          "properties": {
            "project_maximum_length": {"const": 64},
            "agent_maximum_length": {"const": 63},
            "pattern": {"const": "^[a-z][a-z0-9-]*[a-z0-9]$"}
          }
        },
        "connection_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "runtime_principal_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "telemetry_identity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "agents": {
          "type": "array",
          "maxItems": 41,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/runtimeAgent"}
        }
      }
    },
    "runtimeAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "canonical_agent",
        "logical_version",
        "runtime_kind",
        "framework",
        "runtime_agent_name",
        "runtime_agent_version",
        "provider_agent_id",
        "provider_agent_version_id",
        "hosted_identity_id",
        "hosted_blueprint_id",
        "hosted_deployment_id",
        "foundry_agent_name",
        "foundry_agent_version",
        "runtime_principal_id",
        "telemetry_identity_id",
        "connection_ids"
      ],
      "properties": {
        "authority_id": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "canonical_agent": {
          "enum": [
            "weather-agent",
            "healthcare-agent",
            "finance-agent",
            "travel-agent",
            "support-ticket-agent"
          ]
        },
        "logical_version": {
          "oneOf": [
            {"const": "v0"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "runtime_kind": {
          "enum": ["prompt", "hosted_code", "hosted_custom_container"]
        },
        "framework": {
          "enum": [
            "foundry_prompt",
            "microsoft_agent_framework",
            "langgraph",
            "custom_responses"
          ]
        },
        "runtime_agent_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"
        },
        "runtime_agent_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider_agent_id": {"$ref": "#/$defs/reference"},
        "provider_agent_version_id": {"$ref": "#/$defs/reference"},
        "hosted_identity_id": {"$ref": "#/$defs/nullableReference"},
        "hosted_blueprint_id": {"$ref": "#/$defs/nullableReference"},
        "hosted_deployment_id": {"$ref": "#/$defs/nullableReference"},
        "foundry_agent_name": {"type": "string", "minLength": 1, "maxLength": 63},
        "foundry_agent_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "runtime_principal_id": {"$ref": "#/$defs/nullableReference"},
        "telemetry_identity_id": {"$ref": "#/$defs/reference"},
        "connection_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"runtime_kind": {"const": "prompt"}},
            "required": ["runtime_kind"]
          },
          "then": {
            "properties": {
              "hosted_identity_id": {"type": "null"},
              "hosted_blueprint_id": {"type": "null"},
              "hosted_deployment_id": {"type": "null"},
              "runtime_principal_id": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "hosted_identity_id": {"$ref": "#/$defs/reference"},
              "hosted_blueprint_id": {"$ref": "#/$defs/reference"},
              "hosted_deployment_id": {"$ref": "#/$defs/reference"},
              "runtime_principal_id": {"$ref": "#/$defs/reference"}
            }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traffic_started",
        "phase",
        "support_images",
        "recoveries",
        "failures"
      ],
      "properties": {
        "phase": {
          "enum": [
            "phase_1_deployment",
            "phase_1_traffic",
            "phase_2_deployment",
            "phase_2_traffic",
            "complete"
          ]
        },
        "traffic_started": {"type": "boolean"},
        "support_images": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_version", "image"],
            "properties": {
              "logical_version": {
                "oneOf": [
                  {"const": "v0"},
                  {"type": "string", "pattern": "^issue-0(?:29|3[0-6])$"}
                ]
              },
              "image": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.-]+\\.azurecr\\.io/agent-insights-quality-support@sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "recoveries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authority_id",
              "canonical_agent",
              "state",
              "retry_count",
              "error_code"
            ],
            "properties": {
              "authority_id": {
                "oneOf": [
                  {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
                  {"type": "string", "pattern": "^issue-[0-9]{3}$"}
                ]
              },
              "canonical_agent": {
                "enum": [
                  "weather-agent",
                  "healthcare-agent",
                  "finance-agent",
                  "travel-agent",
                  "support-ticket-agent"
                ]
              },
              "state": {"enum": ["ambiguous", "failed", "ready"]},
              "retry_count": {"type": "integer", "minimum": 1, "maximum": 3},
              "error_code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              }
            }
          }
        },
        "failures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authority_id",
              "canonical_agent",
              "stage",
              "error_code",
              "request_accepted"
            ],
            "properties": {
              "authority_id": {
                "oneOf": [
                  {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
                  {"type": "string", "pattern": "^issue-[0-9]{3}$"}
                ]
              },
              "canonical_agent": {
                "enum": [
                  "weather-agent",
                  "healthcare-agent",
                  "finance-agent",
                  "travel-agent",
                  "support-ticket-agent"
                ]
              },
              "stage": {
                "enum": ["deployment", "readiness", "contract", "traffic"]
              },
              "error_code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              "request_accepted": {"type": ["boolean", "null"]},
              "matched_reference_count": {"type": "integer", "minimum": 0},
              "expected_reference_count": {"type": "integer", "minimum": 1},
              "missing_reference_count": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "parent_id",
        "authority_id",
        "deterministic_name",
        "intent_reference",
        "provider_id",
        "resolved_provider_id",
        "runtime_kind",
        "discovery_key",
        "ownership_nonce",
        "create_intent_at",
        "create_observed_at",
        "delete_intent_at",
        "delete_observed_at",
        "state",
        "cleanup_method"
      ],
      "properties": {
        "kind": {
          "enum": [
            "arm_deployment",
            "project",
            "connection",
            "role_assignment",
            "provider_agent",
            "provider_agent_version",
            "hosted_identity",
            "hosted_blueprint",
            "runtime_principal",
            "entra_service_principal",
            "hosted_deployment",
            "session",
            "conversation",
            "stored_response",
            "acr_tag",
            "acr_manifest"
          ]
        },
        "parent_id": {"$ref": "#/$defs/nullableReference"},
        "authority_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z][a-z0-9-]+-agent/v0$"},
            {"type": "string", "pattern": "^issue-[0-9]{3}$"}
          ]
        },
        "deterministic_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "intent_reference": {"$ref": "#/$defs/hash"},
        "provider_id": {"$ref": "#/$defs/reference"},
        "resolved_provider_id": {"$ref": "#/$defs/nullableReference"},
        "runtime_kind": {
          "enum": ["control", "prompt", "hosted_code", "hosted_custom_container"]
        },
        "discovery_key": {"$ref": "#/$defs/reference"},
        "ownership_nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "create_intent_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "create_observed_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "delete_intent_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "delete_observed_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "state": {
          "enum": [
            "create_intent",
            "created",
            "ambiguous_create",
            "delete_intent",
            "deleted",
            "absence_verified",
            "cleanup_blocked"
          ]
        },
        "cleanup_method": {
          "enum": ["explicit", "documented_project_cascade"]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "plan_hash",
        "exact_clean",
        "verified_absent_ids",
        "retained_shared_manifest_ids",
        "residue_ids",
        "verification_at"
      ],
      "properties": {
        "status": {"enum": ["not_started", "in_progress", "exact_clean", "ambiguous"]},
        "plan_hash": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "exact_clean": {"type": "boolean"},
        "verified_absent_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "retained_shared_manifest_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "residue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "verification_at": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
        },
        "failure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/cleanupFailure"}
          ]
        }
      }
    },
    "cleanupFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "resource_kind",
        "http_status",
        "provider_code",
        "error_class"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "resource_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "http_status": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 100, "maximum": 599}
          ]
        },
        "provider_code": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          ]
        },
        "error_class": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{2,127}$"
        }
      }
    },
    "snapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "digest": {"$ref": "#/$defs/hash"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "detail_digest", "failed_at"],
      "properties": {
        "error_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "detail_digest": {"$ref": "#/$defs/hash"},
        "failed_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
