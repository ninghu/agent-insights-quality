{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "agent_name", "logical_version", "requests", "data_class", "traffic_source"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "agent_name": {"type": "string", "minLength": 1},
    "logical_version": {
      "anyOf": [
        {"const": "v0"},
        {"type": "string", "pattern": "^issue-[0-9]{3}$"}
      ]
    },
    "coverage": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requests": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "request", "expected"],
        "not": {"required": ["tool_fixtures"]},
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "headers", "body"],
            "properties": {
              "method": {"const": "POST"},
              "path": {"const": "/responses"},
              "headers": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content-type"],
                "properties": {
                  "content-type": {"const": "application/json"}
                }
              },
              "body": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input"],
                "not": {"required": ["previous_response_id"]},
                "properties": {
                  "input": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["role", "content"],
                      "properties": {
                        "role": {"const": "user"},
                        "content": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["type", "text"],
                            "properties": {
                              "type": {"const": "input_text"},
                              "text": {"type": "string", "minLength": 1}
                            }
                          }
                        }
                      }
                    }
                  },
                  "conversation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1}
                    }
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["http_status", "behavior"],
            "properties": {
              "http_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "activation_gate": {"type": "boolean"},
              "behavior": {"type": "string", "minLength": 1},
              "defect_observed": {"type": "boolean"},
              "required_operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["invoke_agent", "execute_tool", "chat"]
                }
              },
              "semantic_assertions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "response_format": {"enum": ["json", "non_json"]},
                  "exact_text": {"type": "string", "minLength": 1},
                  "json_schema": {
                    "type": "object",
                    "minProperties": 1,
                    "anyOf": [
                      {"required": ["type"]},
                      {"required": ["required"]},
                      {"required": ["properties"]},
                      {"required": ["const"]}
                    ]
                  },
                  "exact_json_fields": {"type": "object", "minProperties": 1},
                  "casefold_json_fields": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "exact_json": {"type": "object", "minProperties": 1},
                  "required_terms_all": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required_terms_any": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "forbidden_terms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required_claims": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "forbidden_claims": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "question_only": {"const": true},
                  "minimum_term_occurrences": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 2
                    }
                  },
                  "max_words": {"type": "integer", "minimum": 1},
                  "min_words": {"type": "integer", "minimum": 1},
                  "max_characters": {"type": "integer", "minimum": 1}
                }
              },
              "trace_assertions": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/traceAssertion"}
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "activation_gate": {"const": true}
                  },
                  "required": ["activation_gate"]
                },
                "then": {
                  "anyOf": [
                    {"required": ["semantic_assertions"]},
                    {"required": ["trace_assertions"]}
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "data_class": {"const": "synthetic_public_safe"},
    "traffic_source": {"const": "endpoint_requests"},
    "validation_rules": {"type": "object"}
  },
  "$defs": {
    "traceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "kind": {
          "enum": [
            "tool_call_count",
            "tool_argument_presence",
            "scope_relation",
            "tool_result_class",
            "retry_sequence",
            "terminal_claim_relation",
            "payload_multiplicity",
            "span_relation",
            "operation_sequence"
          ]
        },
        "tool_name": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0},
        "argument": {"type": "string", "minLength": 1},
        "present": {"type": "boolean"},
        "scope_kind": {"enum": ["account", "trip"]},
        "request_scope": {"enum": ["first", "last"]},
        "result_field": {"type": "string", "minLength": 1},
        "request_tool_equal": {"type": "boolean"},
        "request_result_equal": {"type": "boolean"},
        "tool_result_equal": {"type": "boolean"},
        "result_class": {"enum": ["success", "error", "mixed"]},
        "result_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["success", "error"]}
        },
        "result_path": {"type": "string", "minLength": 1},
        "relation": {
          "enum": ["includes_result", "excludes_result", "overlap", "ordered"]
        },
        "required_terms_all": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_terms": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source": {"enum": ["input_messages", "tool_result"]},
        "path": {"type": "string", "minLength": 1},
        "minimum": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1},
        "first_tool": {"type": "string", "minLength": 1},
        "second_tool": {"type": "string", "minLength": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["invoke_agent", "execute_tool", "chat"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "tool_call_count"}}},
          "then": {"required": ["tool_name", "count"]}
        },
        {
          "if": {"properties": {"kind": {"const": "tool_argument_presence"}}},
          "then": {"required": ["tool_name", "argument", "present"]}
        },
        {
          "if": {"properties": {"kind": {"const": "scope_relation"}}},
          "then": {
            "required": [
              "tool_name",
              "scope_kind",
              "request_scope",
              "argument",
              "request_tool_equal"
            ]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "tool_result_class"}}},
          "then": {"required": ["tool_name", "result_class"]}
        },
        {
          "if": {"properties": {"kind": {"const": "retry_sequence"}}},
          "then": {"required": ["tool_name", "result_sequence"]}
        },
        {
          "if": {"properties": {"kind": {"const": "terminal_claim_relation"}}},
          "then": {"required": ["tool_name"]}
        },
        {
          "if": {"properties": {"kind": {"const": "payload_multiplicity"}}},
          "then": {"required": ["source", "minimum"]}
        },
        {
          "if": {"properties": {"kind": {"const": "span_relation"}}},
          "then": {"required": ["first_tool", "second_tool", "relation"]}
        },
        {
          "if": {"properties": {"kind": {"const": "operation_sequence"}}},
          "then": {"required": ["operations"]}
        }
      ]
    }
  }
}
