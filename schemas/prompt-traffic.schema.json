{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {"$ref": "traffic.schema.json"},
    {
      "properties": {
        "requests": {
          "items": {
            "properties": {
              "expected": {
                "properties": {
                  "required_operations": {"items": {"enum": ["invoke_agent", "chat"]}},
                  "trace_assertions": {
                    "items": {
                      "properties": {
                        "kind": {"enum": ["operation_sequence", "payload_multiplicity"]},
                        "operations": {"items": {"enum": ["invoke_agent", "chat"]}},
                        "source": {"const": "input_messages"},
                        "tool_name": false,
                        "first_tool": false,
                        "second_tool": false
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
