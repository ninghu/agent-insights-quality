{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "agent_name",
    "logical_version",
    "requests",
    "data_class",
    "traffic_source"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "agent_name": {"enum": ["weather-agent", "healthcare-agent"]},
    "logical_version": {
      "anyOf": [
        {"const": "v0"},
        {"type": "string", "pattern": "^issue-[0-9]{3}$"}
      ]
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requests": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "request", "expected"],
        "not": {"required": ["tool_fixtures"]},
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "headers", "body"],
            "properties": {
              "method": {"const": "POST"},
              "path": {"const": "/responses"},
              "headers": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content-type"],
                "properties": {
                  "content-type": {"const": "application/json"}
                }
              },
              "body": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input", "conversation", "max_output_tokens"],
                "not": {
                  "anyOf": [
                    {"required": ["tools"]},
                    {"required": ["tool_choice"]},
                    {"required": ["parallel_tool_calls"]},
                    {"required": ["tool_resources"]},
                    {"required": ["tool_config"]},
                    {"required": ["tool_configuration"]}
                  ]
                },
                "properties": {
                  "input": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"$ref": "#/$defs/inputMessage"}
                  },
                  "conversation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1, "maxLength": 200}
                    }
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["http_status", "behavior", "semantic_assertions"],
            "properties": {
              "http_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "behavior": {"type": "string", "minLength": 1, "maxLength": 1000},
              "defect_observed": {"type": "boolean"},
              "activation_gate": {"type": "boolean"},
              "semantic_assertions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "response_format": {"enum": ["json", "non_json"]},
                  "json_schema": {
                    "type": "object",
                    "minProperties": 1,
                    "anyOf": [
                      {"required": ["type"]},
                      {"required": ["required"]},
                      {"required": ["properties"]},
                      {"required": ["const"]}
                    ]
                  },
                  "exact_json_fields": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"$ref": "#/$defs/jsonValue"}
                  },
                  "exact_json": {"$ref": "#/$defs/jsonValue"},
                  "required_terms_all": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required_terms_any": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "forbidden_terms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required_claims": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "forbidden_claims": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "max_words": {"type": "integer", "minimum": 1},
                  "min_words": {"type": "integer", "minimum": 1},
                  "max_characters": {"type": "integer", "minimum": 1}
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "activation_gate": {"const": true}
                  },
                  "required": ["activation_gate"]
                },
                "then": {"required": ["semantic_assertions"]}
              }
            ]
          }
        }
      }
    },
    "data_class": {"const": "synthetic_public_safe"},
    "traffic_source": {"const": "endpoint_requests"}
  },
  "$defs": {
    "inputMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"const": "user"},
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inputContent"}
        }
      }
    },
    "inputContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "input_text"},
        "text": {"type": "string", "minLength": 1, "maxLength": 8000}
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    }
  }
}
