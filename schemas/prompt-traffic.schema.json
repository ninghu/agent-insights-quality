{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["agent_name", "logical_version", "requests"],
  "properties": {
    "agent_name": {"type": "string", "minLength": 1},
    "logical_version": {
      "anyOf": [
        {"const": "v0"},
        {"type": "string", "pattern": "^issue-[0-9]{3}$"}
      ]
    },
    "requests": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "request", "expected"],
        "not": {"required": ["tool_fixtures"]},
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "request": {
            "type": "object",
            "required": ["method", "path", "body"],
            "properties": {
              "method": {"const": "POST"},
              "path": {"const": "/responses"},
              "body": {
                "type": "object",
                "required": ["input"],
                "not": {"required": ["previous_response_id"]},
                "properties": {
                  "input": {},
                  "conversation": {}
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "properties": {
              "http_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "activation_gate": {"type": "boolean"},
              "semantic_assertions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "response_format": {"enum": ["json", "non_json"]},
                  "json_schema": {
                    "type": "object",
                    "minProperties": 1,
                    "anyOf": [
                      {"required": ["type"]},
                      {"required": ["required"]},
                      {"required": ["properties"]},
                      {"required": ["const"]}
                    ]
                  },
                  "exact_json_fields": {"type": "object", "minProperties": 1},
                  "required_terms_all": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required_terms_any": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "forbidden_terms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required_claims": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "forbidden_claims": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "max_words": {"type": "integer", "minimum": 1},
                  "max_characters": {"type": "integer", "minimum": 1}
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "activation_gate": {"const": true}
                  },
                  "required": ["activation_gate"]
                },
                "then": {"required": ["semantic_assertions"]}
              }
            ]
          }
        }
      }
    }
  }
}
