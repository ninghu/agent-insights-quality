{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninghu.github.io/agent-insights-quality/schemas/v1/email-send-request.schema.json",
  "title": "Connected Microsoft mail send request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "recipient",
    "subject",
    "html",
    "state",
    "retry_delays_seconds",
    "attempt_count",
    "content_digest",
    "transport_strategy",
    "request_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "channel": {"const": "connected_microsoft_mail"},
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "address", "source"],
      "properties": {
        "mode": {"enum": ["authenticated_user", "address", "protected_variable"]},
        "address": {"type": ["string", "null"], "format": "email"},
        "source": {"type": "string", "minLength": 1, "maxLength": 100}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "authenticated_user"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "address": {"type": "null"},
              "source": {"const": "connected_microsoft_mailbox"}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "address"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "address": {"type": "string", "format": "email"}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "protected_variable"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "address": {"type": "null"},
              "source": {"type": "string", "pattern": "^AIQ_[A-Z0-9_]+$"}
            }
          }
        }
      ]
    },
    "subject": {"type": "string", "minLength": 1, "maxLength": 300},
    "html": {"type": "string", "minLength": 1},
    "state": {"const": "unsent"},
    "retry_delays_seconds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "integer", "minimum": 1, "maximum": 3600}
    },
    "attempt_count": {"const": 0},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "transport_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_order",
        "graph_requires_authorization",
        "local_outlook_host_id",
        "local_outlook_requires_authenticated_user",
        "local_outlook_requires_sent_items_verification",
        "stop_after_first_confirmed_success",
        "logic_app_forbidden"
      ],
      "properties": {
        "attempt_order": {
          "const": [
            "connected_copilot_mail",
            "microsoft_graph",
            "local_outlook_com"
          ]
        },
        "graph_requires_authorization": {"const": true},
        "local_outlook_host_id": {"const": "local"},
        "local_outlook_requires_authenticated_user": {"const": true},
        "local_outlook_requires_sent_items_verification": {"const": true},
        "stop_after_first_confirmed_success": {"const": true},
        "logic_app_forbidden": {"const": true}
      }
    },
    "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
