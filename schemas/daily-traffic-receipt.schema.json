{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "execution_id",
    "run_contract_digest",
    "agent_name",
    "logical_version",
    "foundry_version",
    "content_digest",
    "traffic_contract_digest",
    "ambiguity_state",
    "invocation",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "daily-version-traffic-receipt"},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_contract_digest": {"$ref": "#/$defs/hash"},
    "agent_name": {"$ref": "#/$defs/agent"},
    "logical_version": {"$ref": "#/$defs/version"},
    "foundry_version": {"type": "string", "minLength": 1},
    "content_digest": {"$ref": "#/$defs/hash"},
    "traffic_contract_digest": {"$ref": "#/$defs/hash"},
    "ambiguity_state": {"const": "definitive"},
    "invocation": {"type": "object"},
    "receipt_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "agent": {
      "enum": [
        "weather-agent",
        "healthcare-agent",
        "finance-agent",
        "travel-agent",
        "support-ticket-agent"
      ]
    },
    "version": {
      "oneOf": [
        {"const": "v0"},
        {"type": "string", "pattern": "^issue-[0-9]{3}$"}
      ]
    }
  }
}
