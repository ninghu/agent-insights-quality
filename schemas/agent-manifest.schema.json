{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/agent-insights-quality/schemas/v1/agent-manifest.schema.json",
  "title": "Agent Insights Quality agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "required_name_prefix",
    "display_name",
    "domain",
    "agent_type",
    "status",
    "healthy_contract",
    "implementation",
    "endpoint_traffic",
    "correlation",
    "compatible_scenario_tags"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
    "required_name_prefix": {"type": "string", "pattern": "^aiq-[0-9]{3}-[a-z][a-z0-9-]*$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "domain": {
      "enum": ["weather", "healthcare", "finance", "travel", "support_ticket"]
    },
    "agent_type": {
      "enum": ["prompt", "hosted_code", "hosted_custom_container"]
    },
    "status": {"enum": ["placeholder", "active", "retired"]},
    "healthy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibility",
        "immutable",
        "synthetic_data_only",
        "expected_baseline_insights"
      ],
      "properties": {
        "responsibility": {"type": "string", "minLength": 20, "maxLength": 500},
        "immutable": {"const": true},
        "synthetic_data_only": {"const": true},
        "expected_baseline_insights": {"const": 0}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "version_strategy",
        "deployment_protocol",
        "representative_tools"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^agents/[a-z0-9-]+$"
        },
        "version_strategy": {"const": "immutable_digest"},
        "deployment_protocol": {
          "enum": [
            "foundry_prompt_version_rest",
            "foundry_hosted_multipart",
            "foundry_hosted_container_json"
          ]
        },
        "representative_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "endpoint_traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoke_deployed_endpoint",
        "application_insights_access",
        "direct_trace_injection"
      ],
      "properties": {
        "invoke_deployed_endpoint": {"const": true},
        "application_insights_access": {"const": "read_only"},
        "direct_trace_injection": {"const": "forbidden"}
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_response_ids_are_trace_ids",
        "trace_correlation_source"
      ],
      "properties": {
        "invocation_response_ids_are_trace_ids": {"const": false},
        "trace_correlation_source": {"const": "application_insights_operation_id"}
      }
    },
    "compatible_scenario_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
    }
  }
}
