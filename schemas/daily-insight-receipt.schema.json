{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "execution_id",
    "run_contract_digest",
    "agent_name",
    "logical_version",
    "traffic_receipt_digest",
    "verification_result_digest",
    "lookback",
    "intent",
    "run",
    "card_trace_proofs",
    "result",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "daily-version-insight-receipt"},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_contract_digest": {"$ref": "#/$defs/hash"},
    "agent_name": {"type": "string", "minLength": 1},
    "logical_version": {"type": "string", "minLength": 2},
    "traffic_receipt_digest": {"$ref": "#/$defs/hash"},
    "verification_result_digest": {"$ref": "#/$defs/hash"},
    "lookback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traffic_started_at",
        "insight_started_at",
        "start_margin_seconds",
        "precision_minutes",
        "minimum_hours",
        "maximum_hours",
        "lookback_hours",
        "calculation_digest"
      ],
      "properties": {
        "traffic_started_at": {"type": "string", "format": "date-time"},
        "insight_started_at": {"type": "string", "format": "date-time"},
        "start_margin_seconds": {"type": "integer", "minimum": 1},
        "precision_minutes": {"type": "integer", "minimum": 1},
        "minimum_hours": {"type": "number", "minimum": 0.1},
        "maximum_hours": {"type": "number", "minimum": 0.1},
        "lookback_hours": {"type": "number", "minimum": 0.1},
        "calculation_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "intent": {"type": "object"},
    "run": {"type": "object"},
    "card_trace_proofs": {"type": "object"},
    "result": {"type": "object"},
    "receipt_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
