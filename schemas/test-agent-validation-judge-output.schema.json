{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninghu/agent-insights-quality/schemas/test-agent-validation-judge-output.schema.json",
  "title": "Test Agent Validation judge output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "model",
    "prompt_version",
    "prompt_digest",
    "input_digest",
    "baseline_review",
    "issue_reviews",
    "paired_v0_reviews",
    "output_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "test-agent-validation-judge-output"},
    "model": {"const": "gpt-5.6-sol"},
    "prompt_version": {"const": "1.0.0"},
    "prompt_digest": {"$ref": "#/$defs/hash"},
    "input_digest": {"$ref": "#/$defs/hash"},
    "baseline_review": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/baselineConclusion"}
      ]
    },
    "issue_reviews": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/issueConclusion"}
        }
      ]
    },
    "paired_v0_reviews": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/issueConclusion"}
        }
      ]
    },
    "output_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baselineConclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "citations", "reasoning"],
      "properties": {
        "verdict": {"enum": ["healthy", "inconclusive"]},
        "citations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^attempt-[0-9]{2}-(?:endpoint|trace-[0-9]{3,5})$"}
        },
        "reasoning": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "issueConclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_index", "verdict", "citations", "reasoning"],
      "properties": {
        "attempt_index": {"type": "integer", "minimum": 1, "maximum": 7},
        "verdict": {"enum": ["observed", "not_observed", "inconclusive"]},
        "citations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^attempt-[0-9]{2}-(?:endpoint|trace-[0-9]{3,5})$"
          }
        },
        "reasoning": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
